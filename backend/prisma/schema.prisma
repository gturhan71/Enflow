generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Tenant {
  id            String        @id @default(cuid())
  name          String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subscription  Subscription?
  usageMetrics  UsageMetric[]
  customers     Customer[]
  opportunities Opportunity[]
  projects      Project[]
  units         Unit[]
  users         User[]
  contracts     Contract[]
  tasks         TodoTask[]
  archiveItems  ArchiveItem[]
  documents     CorporateDocument[]
  workflows     Workflow[]
  costItems     CostItem[]
  proposals     Proposal[]
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model Subscription {
  id        String           @id @default(cuid())
  plan      SubscriptionPlan @default(STARTER)
  tenantId  String           @unique
  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model UsageMetric {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  feature   String   // e.g., "INTEGRATION_SYNC", "STORAGE"
  count     Int      @default(0)
  period    String   // e.g., "2026-05"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, feature, period])
}

model Unit {
  id          String   @id @default(cuid())
  name        String
  description String?
  tenantId    String
  managerId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  manager     User?    @relation("UnitManager", fields: [managerId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  users       User[]
  steps       WorkflowStep[]
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  role         String
  permissions  String
  status       String        @default("ACTIVE")
  tenantId     String
  unitId       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdOpps  Opportunity[] @relation("CreatedBy")
  assignedOpps Opportunity[] @relation("AssignedTo")
  managedUnits Unit[]        @relation("UnitManager")
  unit         Unit?         @relation(fields: [unitId], references: [id])
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
}

model Customer {
  id                String        @id @default(cuid())
  name              String
  shortName         String?
  industry          String?
  website           String?
  logo              String?
  email             String?
  phone             String?
  address           String?
  city              String?
  country           String?
  postalCode        String?
  taxOffice         String?
  taxNumber         String?
  chamberOfCommerce String?
  tradeRegistryNo   String?
  riskScore         Int           @default(0)
  creditLimit       Float         @default(0)
  currency          String        @default("USD")
  techStack         String?
  socialMedia       String?
  notes             String?
  status            String        @default("ACTIVE")
  tenantId          String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  opportunities     Opportunity[]
}

model Opportunity {
  id                String        @id @default(cuid())
  title             String
  value             Float
  probability       Int
  expectedCloseDate DateTime?
  status            String
  description       String?
  technicalStatus   String        @default("PENDING")
  bomStatus         String        @default("DRAFT")
  tenantId          String
  customerId        String
  assignedToId      String
  createdById       String
  presalesId        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  bomItems          BoMItem[]
  costItems         CostItem[]
  createdBy         User          @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo        User          @relation("AssignedTo", fields: [assignedToId], references: [id])
  customer          Customer      @relation(fields: [customerId], references: [id])
  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  workflowLogs      WorkflowLog[]
  contracts         Contract[]
  proposals         Proposal[]
}

model Proposal {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  content       String      // JSON string with items, terms, description, total
  version       Int         @default(1)
  status        String      @default("DRAFT") // DRAFT, SENT, EXPIRED, REJECTED, ACCEPTED
  tenantId      String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
}

model BoMItem {
  id               String      @id @default(cuid())
  partNumber       String
  description      String
  quantity         Int
  purchaseCost     Float
  marginPercentage Float
  vendor           String?
  opportunityId    String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  opportunity      Opportunity @relation(fields: [opportunityId], references: [id])
}

model CostItem {
  id              String      @id @default(cuid())
  description     String
  category        String      // LABOR, LOGISTICS, TRAVEL, OTHER
  amount          Float
  opportunityId   String
  tenantId        String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id])
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
}

model WorkflowLog {
  id            String      @id @default(cuid())
  fromUnitId    String
  toUnitId      String
  assignedBy    String
  assignedTo    String
  note          String?
  status        String      @default("PENDING")
  opportunityId String
  timestamp     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
}

model Project {
  id               String        @id @default(cuid())
  name             String
  status           String
  totalValue       Float
  avgMargin        Float
  deadline         DateTime
  progress         Int           @default(0)
  customerId       String?
  ownerId          String?
  managerId        String?
  opportunityId    String?       @unique
  procurementNotes String?       // JSON string
  tenantId         String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  tenant           Tenant        @relation(fields: [tenantId], references: [id])
}

model Contract {
  id              String        @id @default(cuid())
  title           String?
  status          String        @default("DRAFT")
  signedDate      DateTime?
  endDate         DateTime?
  guaranteeAmount Float         @default(0)
  guaranteeExpiry DateTime?
  projectId       String?
  opportunityId   String?
  tenantId        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  opportunity     Opportunity?  @relation(fields: [opportunityId], references: [id])
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
}

model TodoTask {
  id            String   @id @default(cuid())
  title         String
  description   String?
  unitId        String
  assignedBy    String
  priority      String   @default("MEDIUM")
  status        String   @default("PENDING")
  dueDate       DateTime?
  progressNotes String?  // JSON string
  relatedModule String?  // PROJECT, OPPORTUNITY, CONTRACT, PROCUREMENT, GENERAL
  relatedItemId String?
  tenantId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
}

model ArchiveItem {
  id          String   @id @default(cuid())
  boxNo       String
  shelfNo     String
  category    String
  description String?
  owner       String
  date        DateTime @default(now())
  status      String   @default("IN_ARCHIVE")
  tags        String?  // Comma separated or JSON
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}

model ActivityLog {
  id            String      @id @default(cuid())
  action        String      // "UPDATE", "CREATE", "DELETE"
  entityType    String      // "OPPORTUNITY", "CUSTOMER", vb.
  entityId      String
  details       String?     // Değişiklik detayları (JSON string)
  userId        String
  tenantId      String
  timestamp     DateTime    @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  timestamp DateTime @default(now())
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CorporateDocument {
  id         String   @id @default(cuid())
  name       String
  category   String
  expiryDate DateTime?
  fileUrl    String?
  tags       String?
  tenantId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
}

model Workflow {
  id          String         @id @default(cuid())
  name        String
  description String?
  isActive    Boolean        @default(true)
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  steps       WorkflowStep[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model WorkflowStep {
  id          String   @id @default(cuid())
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id])
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id])
  order       Int
  type        String   @default("AUTO") // AUTO, MANUAL
  description String
  nextStepId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
