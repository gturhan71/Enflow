generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Tenant {
  id             String        @id @default(cuid())
  name           String
  moduleSettings String        @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  subscription  Subscription?
  usageMetrics  UsageMetric[]
  customers     Customer[]
  opportunities Opportunity[]
  projects      Project[]
  units         Unit[]
  users         User[]
  contracts     Contract[]
  tasks         TodoTask[]
  archiveItems  ArchiveItem[]
  documents     CorporateDocument[]
  workflows     Workflow[]
  costItems          CostItem[]
  proposals          Proposal[]
  contractWorkflows  ContractWorkflow[]
  vendors            Vendor[]
  purchaseRequests   PurchaseRequest[]
  approvalChains     ApprovalChain[]
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model Subscription {
  id                   String           @id @default(cuid())
  plan                 SubscriptionPlan @default(STARTER)
  tenantId             String           @unique
  tenant               Tenant           @relation(fields: [tenantId], references: [id])
  licenseKey           String?
  licenseModel         String?
  licenseExpiryDate    DateTime?
  licensedUserLimit    Int?
  licensedStorageLimit Int?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model UsageMetric {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  feature   String   // e.g., "INTEGRATION_SYNC", "STORAGE"
  count     Int      @default(0)
  period    String   // e.g., "2026-05"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, feature, period])
}

model Unit {
  id          String   @id @default(cuid())
  name        String
  description String?
  tenantId    String
  managerId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  manager     User?    @relation("UnitManager", fields: [managerId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  users       User[]
  steps       WorkflowStep[]
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  role         String
  permissions  String
  status       String        @default("ACTIVE")
  tenantId     String
  unitId       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdOpps  Opportunity[] @relation("CreatedBy")
  assignedOpps Opportunity[] @relation("AssignedTo")
  managedUnits Unit[]        @relation("UnitManager")
  unit         Unit?         @relation(fields: [unitId], references: [id])
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
}

model Customer {
  id                String        @id @default(cuid())
  name              String
  shortName         String?
  industry          String?
  website           String?
  logo              String?
  email             String?
  phone             String?
  address           String?
  city              String?
  country           String?
  postalCode        String?
  taxOffice         String?
  taxNumber         String?
  chamberOfCommerce String?
  tradeRegistryNo   String?
  riskScore         Int           @default(0)
  creditLimit       Float         @default(0)
  currency          String        @default("USD")
  techStack         String?
  socialMedia       String?
  notes             String?
  status            String        @default("ACTIVE")
  tenantId          String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  opportunities     Opportunity[]
}

model Opportunity {
  id                String        @id @default(cuid())
  title             String
  value             Float
  probability       Int
  expectedCloseDate DateTime?
  status            String
  description       String?
  lostReason        String?       // status='LOST' olduğunda kapanış nedeni
  technicalStatus   String        @default("PENDING")
  bomStatus         String        @default("DRAFT")
  costConfig        String?       // JSON: { baseCurrency, rates, marginMode, globalMargin }
  tenantId          String
  customerId        String
  assignedToId      String
  createdById       String
  presalesId        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  bomItems          BoMItem[]
  costItems         CostItem[]
  createdBy         User          @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo        User          @relation("AssignedTo", fields: [assignedToId], references: [id])
  customer          Customer      @relation(fields: [customerId], references: [id])
  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  workflowLogs      WorkflowLog[]
  contracts         Contract[]
  proposals         Proposal[]
}

model Proposal {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  content       String      // JSON string with items, terms, description, total
  version       Int         @default(1)
  status        String      @default("DRAFT") // DRAFT, SENT, EXPIRED, REJECTED, ACCEPTED
  tenantId      String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
}

model BoMItem {
  id               String      @id @default(cuid())
  partNumber       String
  description      String
  quantity         Int
  purchaseCost     Float
  marginPercentage Float
  unitSalePrice    Float?
  totalSalePrice   Float?
  currency         String?
  source           String?
  vendor           String?
  opportunityId    String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  opportunity      Opportunity @relation(fields: [opportunityId], references: [id])
}

model CostItem {
  id              String      @id @default(cuid())
  description     String
  category        String      // LABOR, LOGISTICS, TRAVEL, OTHER
  amount          Float
  currency        String?
  opportunityId   String
  tenantId        String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id])
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
}

model WorkflowLog {
  id            String      @id @default(cuid())
  fromUnitId    String
  toUnitId      String
  assignedBy    String
  assignedTo    String
  note          String?
  status        String      @default("PENDING")
  opportunityId String
  timestamp     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
}

model Project {
  id                String        @id @default(cuid())
  code              String?       // insan-okunur proje kodu, örn. 2026-HW-00012 — sıra no üreticisi otomatik doldurur
  name              String
  type              String        @default("HARDWARE") // HARDWARE | SOFTWARE | SERVICE | MIXED
  description       String?
  status            String        @default("PLANNING")
  // PLANNING | IN_PROGRESS | ON_HOLD | COMPLETED | CANCELLED
  phase             String        @default("PLANNING")
  // Current active phase label for display
  totalValue        Float         @default(0)   // contract value
  contractCurrency  String        @default("TRY")
  budgetTotal       Float         @default(0)
  avgMargin         Float         @default(0)
  deadline          DateTime?
  plannedEndDate    DateTime?
  actualEndDate     DateTime?
  startDate         DateTime?
  progress          Int           @default(0)
  customerId        String?
  customerName      String?
  ownerId           String?
  pmId              String?
  pmName            String?
  managerId         String?
  opportunityId     String?       @unique
  contractId        String?
  procurementNotes  String?       // JSON string
  tenantId          String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  milestones        ProjectMilestone[]
  projectCostItems  ProjectCostItem[]
}

model ProjectMilestone {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  milestoneType   String   @default("CUSTOM")
  // PLANNING | PROCUREMENT | SHIPMENT | INSTALLATION | DEVELOPMENT | TESTING | ACCEPTANCE | INVOICING | COLLECTION | WARRANTY | CUSTOM
  status          String   @default("NOT_STARTED")
  // NOT_STARTED | IN_PROGRESS | COMPLETED | BLOCKED | CANCELLED
  progress        Int      @default(0)
  assignedToId    String?
  assignedToName  String?
  plannedStart    DateTime?
  plannedEnd      DateTime?
  actualStart     DateTime?
  actualEnd       DateTime?
  budgetAmount    Float?
  actualCost      Float?
  currency        String   @default("TRY")
  isParallel      Boolean  @default(false)
  requiresApproval Boolean @default(false)
  approvedById    String?
  approvedAt      DateTime?
  order           Int      @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProjectCostItem {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category        String   @default("OTHER")
  // PROCUREMENT | TRAVEL | EXTERNAL_SERVICE | OTHER
  description     String
  plannedAmount   Float    @default(0)
  actualAmount    Float    @default(0)
  currency        String   @default("TRY")
  amountTRY       Float    @default(0)
  milestoneId     String?
  purchaseRequestId String?
  date            DateTime?
  invoiceNo       String?
  notes           String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Contract {
  id              String        @id @default(cuid())
  title           String?
  status          String        @default("DRAFT")
  signedDate      DateTime?
  endDate         DateTime?
  guaranteeAmount Float         @default(0)
  guaranteeExpiry DateTime?
  projectId       String?
  opportunityId   String?
  tenantId        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  opportunity     Opportunity?  @relation(fields: [opportunityId], references: [id])
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
}

model TodoTask {
  id            String   @id @default(cuid())
  title         String
  description   String?
  unitId        String
  assignedBy    String
  priority      String   @default("MEDIUM")
  status        String   @default("PENDING")
  dueDate       DateTime?
  slaBusinessDays Int?   // verildiyse dueDate bu kadar iş günü sonrasına otomatik hesaplanır
  progressNotes String?  // JSON string
  relatedModule String?  // PROJECT, OPPORTUNITY, CONTRACT, PROCUREMENT, GENERAL
  relatedItemId String?
  tenantId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
}

model ArchiveItem {
  id          String   @id @default(cuid())
  boxNo       String
  shelfNo     String
  category    String
  description String?
  owner       String
  date        DateTime @default(now())
  status      String   @default("IN_ARCHIVE")
  tags        String?  // Comma separated or JSON
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}

model ActivityLog {
  id            String      @id @default(cuid())
  action        String      // "UPDATE", "CREATE", "DELETE"
  entityType    String      // "OPPORTUNITY", "CUSTOMER", vb.
  entityId      String
  details       String?     // Değişiklik detayları (JSON string)
  userId        String
  tenantId      String
  timestamp     DateTime    @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  timestamp DateTime @default(now())
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CorporateDocument {
  id         String   @id @default(cuid())
  name       String
  category   String
  expiryDate DateTime?
  fileUrl    String?
  tags       String?
  tenantId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
}

model Workflow {
  id          String         @id @default(cuid())
  name        String
  description String?
  isActive    Boolean        @default(true)
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  steps       WorkflowStep[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model WorkflowStep {
  id          String   @id @default(cuid())
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id])
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id])
  order       Int
  type        String   @default("AUTO") // AUTO, MANUAL
  description String
  nextStepId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── CONTRACT WORKFLOW (TEST MODULE) ─────────────────────────────────────────

model ContractWorkflow {
  id              String                @id @default(cuid())
  title           String
  opportunityId   String?
  contractId      String?
  contractValue   Float                 @default(0)
  tenderName      String?               // İhale adı (SalesSupport'tan veya manuel)
  tenderNo        String?               // İKN - İhale Kayıt Numarası
  projectName     String?               // Şartnameden AI tarafından çıkarılan proje adı
  contractText    String?
  specText        String?
  aiAnalysis      String?               // JSON
  status          String                @default("DRAFT")
  // DRAFT | ANALYSIS_DONE | PREPARATION | READY_TO_SIGN | SIGNED | TRANSFERRED
  signedDate      DateTime?
  deadline        DateTime?
  notes           String?
  tenantId        String
  tenant          Tenant                @relation(fields: [tenantId], references: [id])
  documents       ContractWorkflowDoc[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model ContractWorkflowDoc {
  id            String           @id @default(cuid())
  workflowId    String
  workflow      ContractWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name          String
  docType       String           // TAX | BANK | LEGAL | FIRM_CERT | SPEC | ADMIN | OTHER
  description   String?
  deadline      DateTime?
  status        String           @default("PENDING")
  // PENDING | IN_PROGRESS | UPLOADED | VERIFIED | WAIVED
  fileUrl       String?
  isRequired    Boolean          @default(true)
  isAiGenerated Boolean          @default(false)
  sortOrder     Int              @default(0)
  notes         String?
  tenantId      String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

// ── Satınalma Modülü ──────────────────────────────────────────────────────

model Vendor {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  taxNo        String?
  address      String?
  phone        String?
  email        String?
  contactName  String?
  iban         String?
  bankName     String?
  categories   String   @default("[]") // JSON string[]
  rating       Float?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  quotes       PurchaseQuote[]
}

model PurchaseRequest {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  title           String
  description     String?
  sourceType      String   @default("MANUAL")
  // MANUAL | BOM | PROJECT | UNIT
  sourceBomId     String?  // Opportunity.id (BoM kaynaksa)
  projectId       String?
  requestedBy     String   // User.id
  requestedByName String?
  unitId          String?
  unitName        String?
  status          String   @default("DRAFT")
  // DRAFT | PENDING_UNIT | PENDING_PROCUREMENT | PENDING_GM | PO_ISSUED | IN_DELIVERY | INVOICED | CLOSED | REJECTED
  urgency         String   @default("NORMAL")
  // LOW | NORMAL | HIGH | URGENT
  neededBy        DateTime?
  budgetAmount    Float?
  currency        String   @default("TRY")
  budgetAmountTRY Float?
  selectedVendorId   String?
  selectedVendorName String?
  poNumber        String?
  poIssuedAt      DateTime?
  invoiceNo       String?
  invoiceAmount   Float?
  invoiceDate     DateTime?
  invoicePaidAt   DateTime?
  approvedByUnit  String?
  approvedByProcurement String?
  approvedByGM    String?
  rejectedBy      String?
  rejectionNote   String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           PurchaseItem[]
  quotes          PurchaseQuote[]
  deliveries      DeliveryRecord[]
}

model PurchaseItem {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  quantity          Float
  unit              String  @default("adet")
  estimatedUnitPrice Float?
  currency          String  @default("TRY")
  actualUnitPrice   Float?
  createdAt         DateTime @default(now())
}

model PurchaseQuote {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  vendorId          String?
  vendor            Vendor?         @relation(fields: [vendorId], references: [id])
  vendorName        String
  totalAmount       Float
  currency          String  @default("TRY")
  totalAmountTRY    Float?
  deliveryDays      Int?
  validUntil        DateTime?
  notes             String?
  isSelected        Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ── Onay Zinciri (Faz 0 — kalıcı ApprovalChain altyapısı) ──────────────────
// workflowService.ts'teki in-memory yapının DB-backed karşılığı.
// Proposal ve ContractWorkflow kendi statü alanlarını korur; bu model
// paralel/ek bir onay geçmişi katmanı olarak eklenir.

model ApprovalChain {
  id         String          @id @default(cuid())
  entityType String          // OPPORTUNITY | PROPOSAL | CONTRACT_WORKFLOW
  entityId   String
  status     String          @default("PENDING") // PENDING | COMPLETED | REJECTED
  tenantId   String
  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  stages     ApprovalStage[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([entityType, entityId])
}

model ApprovalStage {
  id         String        @id @default(cuid())
  chainId    String
  chain      ApprovalChain @relation(fields: [chainId], references: [id], onDelete: Cascade)
  role       String        // FINANCE_MGR | IGPD_MGR | GENERAL_MANAGER | KSU_MGR | ...
  order      Int           @default(0)
  status     String        @default("PENDING") // PENDING | APPROVED | REJECTED | SKIPPED
  approverId String?
  note       String?
  approvedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model DeliveryRecord {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  deliveredAt       DateTime        @default(now())
  receivedBy        String?
  quantityOrdered   Float?
  quantityReceived  Float?
  quantityDamaged   Float?
  status            String  @default("RECEIVED")
  // RECEIVED | PARTIAL | DAMAGED | REJECTED
  notes             String?
  createdAt         DateTime @default(now())
}
