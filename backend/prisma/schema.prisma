generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Tenant {
  id             String        @id @default(cuid())
  name           String
  moduleSettings String        @default("{}")
  // Tenant-başına Data Encryption Key, master key (DATA_ENCRYPTION_MASTER_KEY) ile AES-256-GCM
  // sarmalanmış (envelope encryption) — bkz. backend/src/services/tenantEncryption.ts +
  // docs/TENANT_DATA_ENCRYPTION_PLAN.md
  dekWrapped     String?
  // Dashboard SSE "bir şey değişti" sinyali — DB-native, çoklu-replika güvenli
  // (bkz. backend/src/services/dashboardStream.ts, docs/OLCEKLENDIRME_DUZELTME_PLANI.md
  // Faz C / S-02). Önceden bellek-içi EventEmitter idi, replikalar arası paylaşılmıyordu.
  dashboardPingAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  subscription  Subscription?
  usageMetrics  UsageMetric[]
  customers     Customer[]
  contacts      Contact[]
  serviceTickets ServiceTicket[]
  platformTickets PlatformTicket[]
  fxAdjustments FxAdjustment[]
  opportunities Opportunity[]
  projects      Project[]
  units         Unit[]
  users         User[]
  contracts     Contract[]
  tasks         TodoTask[]
  archiveItems  ArchiveItem[]
  documents     CorporateDocument[]
  workflows     Workflow[]
  costItems          CostItem[]
  proposals          Proposal[]
  contractWorkflows  ContractWorkflow[]
  vendors            Vendor[]
  purchaseRequests   PurchaseRequest[]
  approvalChains     ApprovalChain[]
  visitPlans         VisitPlan[]
  dailyReports       DailyReport[]
  docCodingProfile   DocumentCodingProfile?
  docCategoryCodes   DocumentCategoryCode[]
  docSequences       DocumentSequence[]
  lessonsLearned     LessonsLearned[]
  riskOpportunities  RiskOpportunity[]
  corporateMetrics   CorporateMetric[]
  externalDocuments  ExternalDocumentRegister[]
  invoices           Invoice[]
  payments           Payment[]
  guaranteeLetters   GuaranteeLetter[]
  legalCases         LegalCase[]
  tenders            Tender[]
  unitReports        UnitReport[]
  pluginEntitlements PluginEntitlement[]
  agentRuns          AgentRun[]
  dmoCatalogItems       DmoCatalogItem[]
  dmoFrameworkAgreements DmoFrameworkAgreement[]
  dmoExchangeRates      DmoExchangeRate[]
  dmoOrders             DmoOrder[]
  operatingCostPools    OperatingCostPool[]
  unitBudgets           UnitBudget[]
  brands                Brand[]
  productCategories     ProductCategory[]
  brandSources          BrandSource[]
  opportunityProgressLogs OpportunityProgressLog[]
  costAnalysisVersions    CostAnalysisVersion[]
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model Subscription {
  id                   String           @id @default(cuid())
  plan                 SubscriptionPlan @default(STARTER)
  tenantId             String           @unique
  tenant               Tenant           @relation(fields: [tenantId], references: [id])
  licenseKey           String?
  licenseModel         String?
  licenseExpiryDate    DateTime?
  licensedUserLimit    Int?
  licensedStorageLimit Int?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model UsageMetric {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  feature   String   // e.g., "INTEGRATION_SYNC", "STORAGE"
  count     Int      @default(0)
  period    String   // e.g., "2026-05"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, feature, period])
}

model Unit {
  id          String   @id @default(cuid())
  name        String
  description String?
  tenantId    String
  managerId   String?
  parentId    String?  // üst birim (hiyerarşi — rapor escalation hedefi)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  manager     User?    @relation("UnitManager", fields: [managerId], references: [id])
  parent      Unit?    @relation("UnitHierarchy", fields: [parentId], references: [id])
  children    Unit[]   @relation("UnitHierarchy")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  users       User[]
  steps       WorkflowStep[]
  budgets     UnitBudget[]
  projectParticipations ProjectUnitParticipation[]
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String?
  role         String
  permissions  String
  status       String        @default("ACTIVE")
  tenantId     String
  unitId       String?
  delegateToUserId String?   // onay vekaleti — bu kullanıcı izinliyken yerine onay verebilecek kişi
  delegateUntil    DateTime? // null = süresiz vekalet
  dashboardLayout  String?   // JSON: kişiselleştirilmiş Dashboard widget seçimi/sıralaması — null ise rol varsayılanı kullanılır
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdOpps  Opportunity[] @relation("CreatedBy")
  assignedOpps Opportunity[] @relation("AssignedTo")
  managedUnits Unit[]        @relation("UnitManager")
  unit         Unit?         @relation(fields: [unitId], references: [id])
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  delegateTo   User?         @relation("UserDelegate", fields: [delegateToUserId], references: [id], onDelete: SetNull)
  delegatedFrom User[]       @relation("UserDelegate")
}

model Customer {
  id                String        @id @default(cuid())
  name              String
  shortName         String?
  industry          String?
  website           String?
  logo              String?
  email             String?
  phone             String?
  address           String?
  city              String?
  country           String?
  postalCode        String?
  taxOffice         String?
  taxNumber         String?
  chamberOfCommerce String?
  tradeRegistryNo   String?
  source            String?       // B-06 — lead kaynağı (Referans/Web Sitesi/İhale Duyurusu/...)
  riskScore         Int           @default(0)
  creditLimit       Float         @default(0)
  currency          String        @default("USD")
  techStack         String?
  socialMedia       String?
  notes             String?
  status            String        @default("ACTIVE")
  parentId          String?       // üst müşteri (şube/alt-birim — tek seviye, bkz. Unit.parentId deseni)
  tenantId          String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  parent            Customer?     @relation("CustomerHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children          Customer[]    @relation("CustomerHierarchy")
  opportunities     Opportunity[]
  contacts          Contact[]
  invoices          Invoice[]

  @@index([tenantId, parentId])
}

// Kurumsal müşteride birden çok kişi (satınalma sorumlusu/teknik şartname yazarı/
// muhasebe farklı kişiler olabilir — kamu idarelerinde sık). Customer.email/phone
// dokunulmadı (genel/varsayılan iletişim); Contact bunun üstüne ek bir katman.
model Contact {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  role       String   @default("OTHER") // PURCHASING|TECHNICAL|FINANCE|MANAGEMENT|OTHER
  title      String?  // serbest unvan (ör. "Satınalma Müdürü")
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([tenantId, customerId])
}

model Opportunity {
  id                String        @id @default(cuid())
  trackingCode      String?       // benzersiz takip kodu (açılış tarihi dahil) — nextOpportunityTrackingCode ile üretilir, immutable
  title             String
  value             Float
  currency          String        @default("TRY") // fırsatın tahmini bedeli hangi dövizde girildi
  probability       Int
  expectedCloseDate DateTime?
  status            String
  description       String?
  lostReason        String?       // status='LOST' olduğunda kapanış nedeni
  agentTriage       String?       // JSON: { crm?:{recommendation,issues,at}, igpd?:{recommendation,expectedValue,valueTier,at} } — deterministik agent triyajı (annotation)
  lastProgressCheckAt   DateTime? // son ilerleme teyidi zamanı (null ise createdAt baz alınır)
  progressRemindersSent String?  // JSON dizi — mevcut check-in döngüsünde gönderilen eşikler (ör. ["DUE"]); her teyitte sıfırlanır
  procurementMethod String?       // OPEN|RESTRICTED|NEGOTIATED|DIRECT|PRIVATE — fırsatın hangi satınalma usulüyle teklife dönüşeceği (Satış Destek tetikleyici)
  targetBidDate     DateTime?     // son teklif/dönüşüm tarihi — Satış Destek dosya hazırlık deadline'ı
  bomEvaluation     String?       // JSON — handoff anında alınan BoM tedarikçi teklif değerlendirme snapshot'ı
  technicalStatus   String        @default("PENDING")
  bomStatus         String        @default("DRAFT")
  costConfig        String?       // JSON: { baseCurrency, rates, marginMode, globalMargin }
  tenantId          String
  customerId        String
  assignedToId      String
  createdById       String
  presalesId        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  bomItems          BoMItem[]
  costItems         CostItem[]
  createdBy         User          @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo        User          @relation("AssignedTo", fields: [assignedToId], references: [id])
  customer          Customer      @relation(fields: [customerId], references: [id])
  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  workflowLogs      WorkflowLog[]
  contracts         Contract[]
  proposals         Proposal[]
  progressLogs      OpportunityProgressLog[]
  costAnalysisVersions CostAnalysisVersion[]
  requiredDocs      OpportunityRequiredDoc[]

  @@index([tenantId, status])
  @@index([tenantId, assignedToId])
  @@unique([tenantId, trackingCode])
}

// Fırsat oluşturulurken zorunlu 3 evrak (teknik şartname/idari şartname/sözleşme
// taslağı) + serbest ek evraklar (OTHER). Fırsat evraksız da oluşturulabilir —
// zorunluluk yalnız BoM girişinde (Presales) kontrol edilir, bkz. opportunities.ts
// POST /:id/bom. 3 sabit satırın tekilliği DB-seviyeli değil, uygulama katmanında
// (ilk GET'te seed) garanti edilir — OTHER tipinden birden çok kayıt eklenebilsin diye.
model OpportunityRequiredDoc {
  id            String      @id @default(cuid())
  tenantId      String
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  docType       String      // TECH_SPEC | ADMIN_SPEC | CONTRACT_DRAFT | OTHER
  name          String
  status        String      @default("PENDING") // PENDING | UPLOADED
  fileUrl       String?
  fileName      String?
  isRequired    Boolean     @default(true)
  sortOrder     Int         @default(0)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([tenantId, opportunityId])
}

// Fırsat ilerleme teyidi geçmişi — periyodik zorunlu check-in + olasılık/aşama trendi
model OpportunityProgressLog {
  id                  String      @id @default(cuid())
  tenantId            String
  opportunityId       String
  recordedById        String
  previousStatus      String
  newStatus           String
  previousProbability Int
  newProbability      Int
  changed             Boolean     // status veya probability fiilen değişti mi
  note                String?     // changed=false ise UI'da zorunlu
  createdAt           DateTime    @default(now())
  tenant              Tenant      @relation(fields: [tenantId], references: [id])
  opportunity         Opportunity @relation(fields: [opportunityId], references: [id])

  @@index([tenantId, opportunityId, createdAt])
}

model Proposal {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  content       String      // JSON string with items, terms, description, total
  version       Int         @default(1)
  status        String      @default("DRAFT") // DRAFT, SENT, EXPIRED, REJECTED, ACCEPTED
  rejectionReason String?   // B-21 — REJECTED olunca gerekçe (Opportunity.lostReason ile aynı kategori listesi)
  tenantId      String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
}

// Maliyet analizi versiyon geçmişi — her POST /:id/cost-analysis kaydında BoM/gider/
// costConfig anlık görüntüsü ayrı bir satıra yazılır (Opportunity.bomItems/costItems
// canlı tabloları her kayıtta silinip yeniden oluşturulduğu için geçmiş orada tutulmaz).
// Fırsat kartından "kaç kez maliyet analizi yapıldı" + geçmiş rakamlara dönüp bakma bu tablodan.
model CostAnalysisVersion {
  id            String      @id @default(cuid())
  tenantId      String
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  version       Int         // fırsat içinde 1'den başlayan sıra
  bomItems      String      // JSON — o anki priced BoM satırları
  costItems     String      // JSON — o anki (usul+manuel) gider kalemleri
  costConfig    String      // JSON — o anki CostConfig (usul, kur, marj, vb.)
  grandCost     Float
  offer         Float
  marginPct     Float
  belowFloor    Boolean     @default(false)
  status        String      @default("PENDING_APPROVAL") // PENDING_APPROVAL | APPROVED | REJECTED — sonradan approve-cost ile güncellenir
  createdById   String?
  createdByName String?
  createdAt     DateTime    @default(now())
  tenant        Tenant      @relation(fields: [tenantId], references: [id])

  @@index([tenantId, opportunityId, version])
}

// ── Marka & Ürün Grubu Taksonomisi (2026-08-08, Faz 1) ───────────────────────
// Tenant-yapılandırılabilir, yönetilebilir liste (serbest metin DEĞİL — analitik
// bozulmasın diye). Presales BoM kalemi + DMO katalog kaydı bu ortak listelerden
// seçim yapar. Ayarlar → Marka & Ürün Grubu (GM-only) ekranından yönetilir.
model Brand {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sources   BrandSource[]
  bomItems  BoMItem[]
  dmoCatalogItems DmoCatalogItem[]
  vendors   Vendor[]
  purchaseItems PurchaseItem[]
  serviceTickets ServiceTicket[]
  @@unique([tenantId, name])
}

model ProductCategory {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bomItems  BoMItem[]
  dmoCatalogItems DmoCatalogItem[]
  serviceTickets ServiceTicket[]
  @@unique([tenantId, name])
}

// Bir markanın kayıtlı kaynak/distribütörleri — BoMItem.source alanı marka
// seçildikten sonra bu listeden doldurulur (serbest metin fallback korunur).
model BrandSource {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name      String
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BoMItem {
  id               String      @id @default(cuid())
  lineKey          String?     // stabil satır kimliği (recreate'e rağmen teklif değerlendirme bağı)
  partNumber       String
  description      String
  quantity         Int
  purchaseCost     Float
  marginPercentage Float
  unitSalePrice    Float?
  totalSalePrice   Float?
  currency         String?
  vatRate          Float       @default(20)  // kalem bazında KDV % — teklif KDV hesabı bunu kullanır
  source           String?
  vendor           String?
  paymentTermDays  Int?        // alış ödeme vadesi (referans tarihten gün) — finansman etkisi
  brandId          String?
  brand            Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId       String?
  category         ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  opportunityId    String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  opportunity      Opportunity @relation(fields: [opportunityId], references: [id])
}

// Presales BoM kalemi için vendor teklif değerlendirmesi (fiyat + teknik uygunluk)
model BoMLineQuote {
  id                 String   @id @default(cuid())
  tenantId           String
  opportunityId      String
  lineKey            String   // BoMItem.lineKey ile eşleşir
  componentName      String?  // değerlendirilen kalem adı (cache)
  vendorId           String?
  vendorName         String
  unitPrice          Float
  currency           String   @default("TRY")
  technicalCompliance String  @default("COMPLIANT") // COMPLIANT | PARTIAL | NON_COMPLIANT
  specSummary        String?  // teknik uygunluk notu/özeti
  deliveryDays       Int?
  validUntil         DateTime?
  notes              String?
  isSelected         Boolean  @default(false)
  fileUrl            String?  // orijinal teklif dosyası (xls/xml/doc/pdf) — seçim kanıtı
  fileName           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@index([opportunityId, lineKey])
}

model CostItem {
  id              String      @id @default(cuid())
  description     String
  category        String      // CostCategory (procurementCosts.ts)
  amount          Float
  currency        String?
  auto            Boolean     @default(false) // usule göre otomatik gelen masraf mı
  paymentTermDays Int?        // ödeme vadesi (referans tarihten gün) — finansman etkisi
  opportunityId   String
  tenantId        String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id])
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
}

model WorkflowLog {
  id            String      @id @default(cuid())
  fromUnitId    String
  toUnitId      String
  assignedBy    String
  assignedTo    String
  note          String?
  status        String      @default("PENDING")
  opportunityId String
  timestamp     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
}

model Project {
  id                String        @id @default(cuid())
  code              String?       // insan-okunur proje kodu, örn. 2026-HW-00012 — sıra no üreticisi otomatik doldurur
  name              String
  type              String        @default("HARDWARE") // HARDWARE | SOFTWARE | SERVICE | MIXED
  description       String?
  status            String        @default("PLANNING")
  // PLANNING | IN_PROGRESS | ON_HOLD | COMPLETED | CANCELLED
  phase             String        @default("PLANNING")
  // Current active phase label for display
  totalValue        Float         @default(0)   // contract value
  contractCurrency  String        @default("TRY")
  budgetTotal       Float         @default(0)
  avgMargin         Float         @default(0)   // direkt (katkı) marj — overhead hariç
  // İşletme maliyeti (overhead) — yönetim insiyatifi (default kapalı; eski projeler etkilenmez)
  applyOverhead     Boolean       @default(false)
  overheadAmount    Float         @default(0)   // hesaplanan işletme maliyeti (TRY)
  netMargin         Float         @default(0)   // tam-yüklü marj (değer − direkt − overhead)/değer
  deadline          DateTime?
  plannedEndDate    DateTime?
  actualEndDate     DateTime?
  startDate         DateTime?
  progress          Int           @default(0)
  customerId        String?
  customerName      String?
  ownerId           String?
  pmId              String?
  pmName            String?
  managerId         String?
  opportunityId     String?       @unique
  contractId        String?
  procurementNotes  String?       // JSON string
  tenantId          String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  milestones        ProjectMilestone[]
  projectCostItems  ProjectCostItem[]
  handoverDocs      ProjectHandoverDoc[]
  unitParticipations ProjectUnitParticipation[]
  serviceTickets    ServiceTicket[]

  @@index([tenantId, status])
}

// B-22 — Garanti/Servis: ACCEPTANCE sonrası (WARRANTY döneminde) arıza bildirimi,
// yedek parça talebi, servis SLA takibi. Önceden WARRANTY yalnız bir milestone
// etiketiydi; gerçek talep bu modele düşer.
model ServiceTicket {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  projectId           String
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  category            String    @default("FAULT") // FAULT|SPARE_PART|MAINTENANCE|OTHER
  priority            String    @default("NORMAL") // LOW|NORMAL|HIGH|URGENT
  status              String    @default("OPEN")   // OPEN|IN_PROGRESS|WAITING_PART|RESOLVED|CLOSED
  reportedAt          DateTime  @default(now())
  reportedByContactId String?   // Customer.Contact — bildiren kişi (opsiyonel)
  reportedByName      String?   // Contact yoksa serbest metin
  assignedToUserId    String?
  unitId              String?
  slaHours            Int?      // hedef çözüm süresi (takvim-saati)
  dueAt               DateTime? // slaHours verilmişse create'de otomatik hesaplanır
  escalatedAt         DateTime? // SLA aşımı bildirimi bir kez gitti mi (idempotent)
  resolvedAt          DateTime?
  resolutionNotes     String?
  costAmount          Float?    // çözüm maliyeti (yedek parça/işçilik) — opsiyonel
  costCurrency        String?   // costAmount girildiyse zorunlu anlamda kullanılır
  brandId             String?   // ilgili ürünün markası (2026-08-09, Faz 3) — opsiyonel, tek etiket (satır granülaritesi yok)
  brand               Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  productCategoryId   String?   // `category` alanı zaten arıza tipini taşıdığı için ayrı isim
  productCategory     ProductCategory? @relation(fields: [productCategoryId], references: [id], onDelete: SetNull)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  @@index([tenantId, status])
  @@index([tenantId, projectId])
}

// Enflow SaaS'ı kullanan tenant'ların ürün geri bildirimi/hata/iyileştirme/mimari
// değişiklik talepleri. ServiceTicket'tan FARKLI bir domain: ServiceTicket tenant'ın
// KENDİ müşterisine verdiği garanti/servis kaydıdır (iş verisi); PlatformTicket ise
// tenant'ın Enflow'un kendisine (vendor'a) gönderdiği platform-seviyesi bir talep.
// category/priority/scope/status/targetTimeline/resolutionNote alanları YALNIZ
// ayrı bir dış triage aracı (bu repo dışında) tarafından, platform-tickets-admin
// API'si üzerinden doldurulur — tenant kullanıcısı title+description'a ek olarak
// yalnız kendi ilk izlenimini (reportedType) bildirir; nihai sınıflandırma (category)
// bundan bağımsız olarak dış araç tarafından belirlenir (örn. "yorum" olarak açılan
// bir talep değerlendirmede "mimari değişiklik" olarak sınıflandırılabilir).
model PlatformTicket {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String   // gönderen — izolasyon değil, izleme amaçlı düz alan (ilişki yok)
  userName       String   // gönderim anındaki ad snapshot'ı (kullanıcı sonradan devredilebilir/pasifleşebilir)
  title          String
  description    String
  reportedType   String   @default("BUG") // BUG|IMPROVEMENT|COMMENT — kullanıcının gönderirken seçtiği ilk tip
  scope          String?  // TENANT_SPECIFIC|PLATFORM_WIDE — yalnız dış triage aracı doldurur
  category       String?  // BUG|IMPROVEMENT|ARCHITECTURE_CHANGE — yalnız dış triage aracı doldurur (nihai sınıflandırma)
  priority       String?  // CRITICAL|HIGH|MEDIUM|LOW — yalnız dış triage aracı doldurur
  status         String   @default("NEW") // NEW|TRIAGED|PLANNED|IN_PROGRESS|DONE|REJECTED
  targetTimeline String?  // serbest metin, örn. "Q3 2026" — dış triage aracı yazar
  resolutionNote String?  // tamamlanınca/reddedilince kullanıcıya görünecek not
  metadata       String?  // dış aracın serbest JSON notu (String, manuel parse — SQLite'ta native Json yok)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([tenantId, status])
}

model ProjectMilestone {
