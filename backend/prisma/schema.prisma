  plannedAmount   Float    @default(0)
  actualAmount    Float    @default(0)
  currency        String   @default("TRY")
  amountTRY       Float    @default(0)
  milestoneId     String?
  purchaseRequestId String?
  serviceTicketId String?  // Garanti & Servis maliyeti (idempotent anahtar)
  bomLineKey      String?  // BoMItem.lineKey — dolu ise BoM Maliyet Varyansı satır bazında karşılaştırır
  date            DateTime?
  invoiceNo       String?
  notes           String?
  createdById     String?
  // Finans onayı (Faz 6) — geriye uyumlu: eski kayıtlar APPROVED
  approvalStatus  String   @default("APPROVED") // PENDING | APPROVED | REJECTED
  approvedById    String?
  approvedAt      DateTime?
  approvalNote    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
