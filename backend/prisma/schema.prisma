generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Tenant {
  id             String        @id @default(cuid())
  name           String
  moduleSettings String        @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  subscription  Subscription?
  usageMetrics  UsageMetric[]
  customers     Customer[]
  opportunities Opportunity[]
  projects      Project[]
  units         Unit[]
  users         User[]
  contracts     Contract[]
  tasks         TodoTask[]
  archiveItems  ArchiveItem[]
  documents     CorporateDocument[]
  workflows     Workflow[]
  costItems          CostItem[]
  proposals          Proposal[]
  contractWorkflows  ContractWorkflow[]
  vendors            Vendor[]
  purchaseRequests   PurchaseRequest[]
  approvalChains     ApprovalChain[]
  visitPlans         VisitPlan[]
  dailyReports       DailyReport[]
  docCodingProfile   DocumentCodingProfile?
  docCategoryCodes   DocumentCategoryCode[]
  docSequences       DocumentSequence[]
  lessonsLearned     LessonsLearned[]
  riskOpportunities  RiskOpportunity[]
  corporateMetrics   CorporateMetric[]
  externalDocuments  ExternalDocumentRegister[]
  invoices           Invoice[]
  payments           Payment[]
  guaranteeLetters   GuaranteeLetter[]
  legalCases         LegalCase[]
  tenders            Tender[]
  unitReports        UnitReport[]
  pluginEntitlements PluginEntitlement[]
  agentRuns          AgentRun[]
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model Subscription {
  id                   String           @id @default(cuid())
  plan                 SubscriptionPlan @default(STARTER)
  tenantId             String           @unique
  tenant               Tenant           @relation(fields: [tenantId], references: [id])
  licenseKey           String?
  licenseModel         String?
  licenseExpiryDate    DateTime?
  licensedUserLimit    Int?
  licensedStorageLimit Int?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model UsageMetric {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  feature   String   // e.g., "INTEGRATION_SYNC", "STORAGE"
  count     Int      @default(0)
  period    String   // e.g., "2026-05"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, feature, period])
}

model Unit {
  id          String   @id @default(cuid())
  name        String
  description String?
  tenantId    String
  managerId   String?
  parentId    String?  // üst birim (hiyerarşi — rapor escalation hedefi)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  manager     User?    @relation("UnitManager", fields: [managerId], references: [id])
  parent      Unit?    @relation("UnitHierarchy", fields: [parentId], references: [id])
  children    Unit[]   @relation("UnitHierarchy")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  users       User[]
  steps       WorkflowStep[]
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  role         String
  permissions  String
  status       String        @default("ACTIVE")
  tenantId     String
  unitId       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdOpps  Opportunity[] @relation("CreatedBy")
  assignedOpps Opportunity[] @relation("AssignedTo")
  managedUnits Unit[]        @relation("UnitManager")
  unit         Unit?         @relation(fields: [unitId], references: [id])
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
}

model Customer {
  id                String        @id @default(cuid())
  name              String
  shortName         String?
  industry          String?
  website           String?
  logo              String?
  email             String?
  phone             String?
  address           String?
  city              String?
  country           String?
  postalCode        String?
  taxOffice         String?
  taxNumber         String?
  chamberOfCommerce String?
  tradeRegistryNo   String?
  riskScore         Int           @default(0)
  creditLimit       Float         @default(0)
  currency          String        @default("USD")
  techStack         String?
  socialMedia       String?
  notes             String?
  status            String        @default("ACTIVE")
  tenantId          String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  opportunities     Opportunity[]
}

model Opportunity {
  id                String        @id @default(cuid())
  title             String
  value             Float
  probability       Int
  expectedCloseDate DateTime?
  status            String
  description       String?
  lostReason        String?       // status='LOST' olduğunda kapanış nedeni
  agentTriage       String?       // JSON: { crm?:{recommendation,issues,at}, igpd?:{recommendation,expectedValue,valueTier,at} } — deterministik agent triyajı (annotation)
  procurementMethod String?       // OPEN|RESTRICTED|NEGOTIATED|DIRECT|PRIVATE — fırsatın hangi satınalma usulüyle teklife dönüşeceği (Satış Destek tetikleyici)
  targetBidDate     DateTime?     // son teklif/dönüşüm tarihi — Satış Destek dosya hazırlık deadline'ı
  bomEvaluation     String?       // JSON — handoff anında alınan BoM tedarikçi teklif değerlendirme snapshot'ı
  technicalStatus   String        @default("PENDING")
  bomStatus         String        @default("DRAFT")
  costConfig        String?       // JSON: { baseCurrency, rates, marginMode, globalMargin }
  tenantId          String
  customerId        String
  assignedToId      String
  createdById       String
  presalesId        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  bomItems          BoMItem[]
  costItems         CostItem[]
  createdBy         User          @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo        User          @relation("AssignedTo", fields: [assignedToId], references: [id])
  customer          Customer      @relation(fields: [customerId], references: [id])
  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  workflowLogs      WorkflowLog[]
  contracts         Contract[]
  proposals         Proposal[]
}

model Proposal {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  content       String      // JSON string with items, terms, description, total
  version       Int         @default(1)
  status        String      @default("DRAFT") // DRAFT, SENT, EXPIRED, REJECTED, ACCEPTED
  tenantId      String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
}

model BoMItem {
  id               String      @id @default(cuid())
  lineKey          String?     // stabil satır kimliği (recreate'e rağmen teklif değerlendirme bağı)
  partNumber       String
  description      String
  quantity         Int
  purchaseCost     Float
  marginPercentage Float
  unitSalePrice    Float?
  totalSalePrice   Float?
  currency         String?
  source           String?
  vendor           String?
  opportunityId    String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  opportunity      Opportunity @relation(fields: [opportunityId], references: [id])
}

// Presales BoM kalemi için vendor teklif değerlendirmesi (fiyat + teknik uygunluk)
model BoMLineQuote {
  id                 String   @id @default(cuid())
  tenantId           String
  opportunityId      String
  lineKey            String   // BoMItem.lineKey ile eşleşir
  componentName      String?  // değerlendirilen kalem adı (cache)
  vendorId           String?
  vendorName         String
  unitPrice          Float
  currency           String   @default("TRY")
  technicalCompliance String  @default("COMPLIANT") // COMPLIANT | PARTIAL | NON_COMPLIANT
  specSummary        String?  // teknik uygunluk notu/özeti
  deliveryDays       Int?
  validUntil         DateTime?
  notes              String?
  isSelected         Boolean  @default(false)
  fileUrl            String?  // orijinal teklif dosyası (xls/xml/doc/pdf) — seçim kanıtı
  fileName           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@index([opportunityId, lineKey])
}

model CostItem {
  id              String      @id @default(cuid())
  description     String
  category        String      // CostCategory (procurementCosts.ts)
  amount          Float
  currency        String?
  auto            Boolean     @default(false) // usule göre otomatik gelen masraf mı
  opportunityId   String
  tenantId        String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id])
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
}

model WorkflowLog {
  id            String      @id @default(cuid())
  fromUnitId    String
  toUnitId      String
  assignedBy    String
  assignedTo    String
  note          String?
  status        String      @default("PENDING")
  opportunityId String
  timestamp     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
}

model Project {
  id                String        @id @default(cuid())
  code              String?       // insan-okunur proje kodu, örn. 2026-HW-00012 — sıra no üreticisi otomatik doldurur
  name              String
  type              String        @default("HARDWARE") // HARDWARE | SOFTWARE | SERVICE | MIXED
  description       String?
  status            String        @default("PLANNING")
  // PLANNING | IN_PROGRESS | ON_HOLD | COMPLETED | CANCELLED
  phase             String        @default("PLANNING")
  // Current active phase label for display
  totalValue        Float         @default(0)   // contract value
  contractCurrency  String        @default("TRY")
  budgetTotal       Float         @default(0)
  avgMargin         Float         @default(0)
  deadline          DateTime?
  plannedEndDate    DateTime?
  actualEndDate     DateTime?
  startDate         DateTime?
  progress          Int           @default(0)
  customerId        String?
  customerName      String?
  ownerId           String?
  pmId              String?
  pmName            String?
  managerId         String?
  opportunityId     String?       @unique
  contractId        String?
  procurementNotes  String?       // JSON string
  tenantId          String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  milestones        ProjectMilestone[]
  projectCostItems  ProjectCostItem[]
  handoverDocs      ProjectHandoverDoc[]
}

model ProjectMilestone {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  milestoneType   String   @default("CUSTOM")
  // PLANNING | PROCUREMENT | SHIPMENT | INSTALLATION | DEVELOPMENT | TESTING | ACCEPTANCE | INVOICING | COLLECTION | WARRANTY | CUSTOM
  status          String   @default("NOT_STARTED")
  // NOT_STARTED | IN_PROGRESS | COMPLETED | BLOCKED | CANCELLED
  progress        Int      @default(0)
  assignedToId    String?
  assignedToName  String?
  plannedStart    DateTime?
  plannedEnd      DateTime?
  actualStart     DateTime?
  actualEnd       DateTime?
  budgetAmount    Float?
  actualCost      Float?
  currency        String   @default("TRY")
  isParallel      Boolean  @default(false)
  requiresApproval Boolean @default(false)
  approvedById    String?
  approvedAt      DateTime?
  order           Int      @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProjectCostItem {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category        String   @default("OTHER")
  // PROCUREMENT | TRAVEL | EXTERNAL_SERVICE | OTHER
  description     String
  plannedAmount   Float    @default(0)
  actualAmount    Float    @default(0)
  currency        String   @default("TRY")
  amountTRY       Float    @default(0)
  milestoneId     String?
  purchaseRequestId String?
  date            DateTime?
  invoiceNo       String?
  notes           String?
  createdById     String?
  // Finans onayı (Faz 6) — geriye uyumlu: eski kayıtlar APPROVED
  approvalStatus  String   @default("APPROVED") // PENDING | APPROVED | REJECTED
  approvedById    String?
  approvedAt      DateTime?
  approvalNote    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Contract {
  id              String        @id @default(cuid())
  title           String?
  status          String        @default("DRAFT")
  signedDate      DateTime?
  endDate         DateTime?
  guaranteeAmount Float         @default(0)
  guaranteeExpiry DateTime?
  projectId       String?
  opportunityId   String?
  tenantId        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  opportunity     Opportunity?  @relation(fields: [opportunityId], references: [id])
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
}

model TodoTask {
  id            String   @id @default(cuid())
  title         String
  description   String?
  unitId        String
  assignedBy    String
  priority      String   @default("MEDIUM")
  status        String   @default("PENDING")
  dueDate       DateTime?
  slaBusinessDays Int?   // verildiyse dueDate bu kadar iş günü sonrasına otomatik hesaplanır
  progressNotes String?  // JSON string
  relatedModule String?  // PROJECT, OPPORTUNITY, CONTRACT, PROCUREMENT, GENERAL
  relatedItemId String?
  agentRunId    String?  // bu görevi üreten sanal agent çalıştırması (köken etiketi)
  tenantId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
}

model ArchiveItem {
  id          String   @id @default(cuid())
  boxNo       String
  shelfNo     String
  category    String
  description String?
  owner       String
  date        DateTime @default(now())
  status      String   @default("IN_ARCHIVE")
  tags        String?  // Comma separated or JSON
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}

model ActivityLog {
  id            String      @id @default(cuid())
  action        String      // "UPDATE", "CREATE", "DELETE"
  entityType    String      // "OPPORTUNITY", "CUSTOMER", vb.
  entityId      String
  details       String?     // Değişiklik detayları (JSON string)
  userId        String
  actorType     String?     // HUMAN | AGENT — işlemi yapan aktörün tipi (köken etiketi)
  agentRunId    String?     // AGENT ise ilgili sanal agent çalıştırması
  tenantId      String
  timestamp     DateTime    @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  timestamp DateTime @default(now())
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CorporateDocument {
  id         String   @id @default(cuid())
  name       String
  category   String
  expiryDate DateTime?
  fileUrl    String?
  tags       String?
  docNumber  String?  // tenant doküman kodlama profilinden üretilen özgün kod (opsiyonel)
  tenantId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
}

model Workflow {
  id          String         @id @default(cuid())
  name        String
  description String?
  isActive    Boolean        @default(true)
  isDefault   Boolean        @default(false) // tenant başına tek varsayılan şablon
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  steps       WorkflowStep[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model WorkflowStep {
  id                 String   @id @default(cuid())
  workflowId         String
  workflow           Workflow @relation(fields: [workflowId], references: [id])
  unitId             String
  unit               Unit     @relation(fields: [unitId], references: [id])
  order              Int
  type               String   @default("AUTO") // AUTO, MANUAL
  description        String
  nextStepId         String?
  enabled            Boolean  @default(true)  // false = birim akıştan çıkarıldı, görevler sıradaki aktif birime yönlenir
  requiresCompletion Boolean  @default(false) // devretmeden önce birimin gereklilikleri tamamlaması gerekir
  completionNote     String?  // gereklilik açıklaması (uyarıda gösterilir)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ── CONTRACT WORKFLOW (TEST MODULE) ─────────────────────────────────────────

model ContractWorkflow {
  id              String                @id @default(cuid())
  title           String
  opportunityId   String?
  contractId      String?
  contractValue   Float                 @default(0)
  tenderName      String?               // İhale adı (SalesSupport'tan veya manuel)
  tenderNo        String?               // İKN - İhale Kayıt Numarası
  projectName     String?               // Şartnameden AI tarafından çıkarılan proje adı
  contractText    String?
  specText        String?
  aiAnalysis      String?               // JSON
  status          String                @default("DRAFT")
  // DRAFT | ANALYSIS_DONE | PREPARATION | READY_TO_SIGN | SIGNED | TRANSFERRED
  signedDate      DateTime?
  deadline        DateTime?
  notes           String?
  projectId       String?               // /transfer ile oluşturulan Project (idempotency + bağ)
  procurementRequestId String?          // /handoff-procurement ile oluşturulan PurchaseRequest (idempotency + bağ)
  tenantId        String
  tenant          Tenant                @relation(fields: [tenantId], references: [id])
  documents       ContractWorkflowDoc[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model ContractWorkflowDoc {
  id            String           @id @default(cuid())
  workflowId    String
  workflow      ContractWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name          String
  docType       String           // TAX | BANK | LEGAL | FIRM_CERT | SPEC | ADMIN | OTHER
  description   String?
  deadline      DateTime?
  status        String           @default("PENDING")
  // PENDING | IN_PROGRESS | UPLOADED | VERIFIED | WAIVED
  fileUrl       String?
  isRequired    Boolean          @default(true)
  isAiGenerated Boolean          @default(false)
  sortOrder     Int              @default(0)
  notes         String?
  docNumber     String?          // tenant doküman kodlama profilinden üretilen özgün kod (opsiyonel)
  tenantId      String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

// ── Satınalma Modülü ──────────────────────────────────────────────────────

model Vendor {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  taxNo        String?
  address      String?
  phone        String?
  email        String?
  contactName  String?
  iban         String?
  bankName     String?
  categories   String   @default("[]") // JSON string[]
  rating       Float?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  quotes       PurchaseQuote[]
}

model PurchaseRequest {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  title           String
  description     String?
  sourceType      String   @default("MANUAL")
  // MANUAL | BOM | PROJECT | UNIT
  sourceBomId     String?  // Opportunity.id (BoM kaynaksa)
  projectId       String?
  requestedBy     String   // User.id
  requestedByName String?
  unitId          String?
  unitName        String?
  status          String   @default("DRAFT")
  // DRAFT | PENDING_UNIT | PENDING_PROCUREMENT | PENDING_GM | PO_ISSUED | IN_DELIVERY | INVOICED | CLOSED | REJECTED
  urgency         String   @default("NORMAL")
  // LOW | NORMAL | HIGH | URGENT
  neededBy        DateTime?
  budgetAmount    Float?
  currency        String   @default("TRY")
  budgetAmountTRY Float?
  selectedVendorId   String?
  selectedVendorName String?
  poNumber        String?
  poIssuedAt      DateTime?
  invoiceNo       String?
  invoiceAmount   Float?
  invoiceDate     DateTime?
  invoicePaidAt   DateTime?
  approvedByUnit  String?
  approvedByProcurement String?
  approvedByGM    String?
  rejectedBy      String?
  rejectionNote   String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           PurchaseItem[]
  quotes          PurchaseQuote[]
  deliveries      DeliveryRecord[]
}

model PurchaseItem {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  quantity          Float
  unit              String  @default("adet")
  estimatedUnitPrice Float?
  currency          String  @default("TRY")
  actualUnitPrice   Float?
  refVendor         String?  // BoM kaynağı: üretici/distribütör adı (referans alış fiyatının kaynağı)
  refSource         String?  // BoM source — referans fiyat kaynağı türü
  createdAt         DateTime @default(now())
}

model PurchaseQuote {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  vendorId          String?
  vendor            Vendor?         @relation(fields: [vendorId], references: [id])
  vendorName        String
  totalAmount       Float
  currency          String  @default("TRY")
  totalAmountTRY    Float?
  deliveryDays      Int?
  validUntil        DateTime?
  notes             String?
  isSelected        Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ── Onay Zinciri (Faz 0 — kalıcı ApprovalChain altyapısı) ──────────────────
// workflowService.ts'teki in-memory yapının DB-backed karşılığı.
// Proposal ve ContractWorkflow kendi statü alanlarını korur; bu model
// paralel/ek bir onay geçmişi katmanı olarak eklenir.

model ApprovalChain {
  id         String          @id @default(cuid())
  entityType String          // OPPORTUNITY | PROPOSAL | CONTRACT_WORKFLOW
  entityId   String
  status     String          @default("PENDING") // PENDING | COMPLETED | REJECTED
  tenantId   String
  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  stages     ApprovalStage[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([entityType, entityId])
}

model ApprovalStage {
  id         String        @id @default(cuid())
  chainId    String
  chain      ApprovalChain @relation(fields: [chainId], references: [id], onDelete: Cascade)
  role       String        // FINANCE_MGR | IGPD_MGR | GENERAL_MANAGER | KSU_MGR | ...
  order      Int           @default(0)
  status     String        @default("PENDING") // PENDING | APPROVED | REJECTED | SKIPPED
  approverId String?       // 'AGENT:<pluginKey>' ise sanal agent onayladı
  note       String?
  approvedAt DateTime?
  agentRunId String?       // bu aşamayı onaylayan sanal agent çalıştırması (köken etiketi)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

// ── Ziyaret Planı & Günlük Rapor (Faz 2) ────────────────────────────────────
// Diyagramdaki "süreç öncesi" katman: haftalık müşteri ziyaret planı + günlük
// rapor, haftalık olarak bağlı bulunan yöneticiyle (İGPD) paylaşılır.

model VisitPlan {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  weekOf         DateTime // o haftanın Pazartesi tarihi
  preparedById   String
  preparedByName String?
  status         String   @default("DRAFT") // DRAFT | APPROVED | COMPLETED
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  visits         Visit[]
}

model Visit {
  id            String    @id @default(cuid())
  visitPlanId   String
  visitPlan     VisitPlan @relation(fields: [visitPlanId], references: [id], onDelete: Cascade)
  customerId    String?
  customerName  String?
  type          String    @default("OTHER") // DEMO | TECHNICAL_MEETING | PRESENTATION | OTHER
  plannedDate   DateTime
  actualDate    DateTime?
  status        String    @default("PLANNED") // PLANNED | COMPLETED | CANCELLED
  needsCaptured String?   // müşteri ihtiyaçları / görüşme notları
  tenantId      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model DailyReport {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  userId            String
  userName          String?
  date              DateTime
  content           String   // serbest metin günlük rapor
  // İş bağlantısı matrisi (2 eksen): hangi iş üzerine raporlandı
  meetingKind       String   @default("OTHER")       // INTRO(tanışma)|PLANNED|FOLLOWUP|OTHER
  linkType          String   @default("NEW_CONTACT") // NEW_CONTACT|VISIT|OPPORTUNITY|PROJECT
  linkId            String?                          // bağlı varlık id (soft-link); NEW_CONTACT'ta null
  linkLabel         String?                          // anlık etiket (müşteri/fırsat/proje adı veya yeni iletişim)
  isKnownToSystem   Boolean  @default(false)         // linkType != NEW_CONTACT (backend türetir)
  sharedWithManager Boolean  @default(false) // dönem-toplu yöneticiyle paylaşıldı mı
  sharedAt          DateTime?                        // toplu paylaşım anı
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ── Proje Devir Paketi (Faz 2) ───────────────────────────────────────────────
// ContractWorkflowDoc pattern'inin doğrudan klonu — zorunlu evrak checklist'i,
// otomatik durum ilerletme ve multer/Nextcloud upload aynı şekilde çalışır.

model ProjectHandoverDoc {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  docType     String   // FEASIBILITY | TENDER_DOCS | CONTRACT | PRICE_SCHEDULE | COST_TABLE | BOM_TREE | RECEIVED_QUOTES | TENDER_DECISION | GUARANTEE_LETTERS | HANDOVER_FORM | STAFF_LIST | OTHER
  description String?
  status      String   @default("PENDING") // PENDING | IN_PROGRESS | UPLOADED | VERIFIED | WAIVED
  fileUrl     String?
  isRequired  Boolean  @default(true)
  sortOrder   Int      @default(0)
  notes       String?
  docNumber   String?  // tenant doküman kodlama profilinden üretilen özgün kod (opsiyonel)
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DeliveryRecord {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  deliveredAt       DateTime        @default(now())
  receivedBy        String?
  quantityOrdered   Float?
  quantityReceived  Float?
  quantityDamaged   Float?
  status            String  @default("RECEIVED")
  // RECEIVED | PARTIAL | DAMAGED | REJECTED
  notes             String?
  createdAt         DateTime @default(now())
}

// ── Özgün Doküman Kodlama Sistemi (Faz 3) ────────────────────────────────────
// Hiçbir üçüncü-taraf notasyonu gömülmez. Her tenant kendi ISO 9001 doküman
// kontrol standardını Ayarlar → Şirket Profili'nden tanımlar. Varsayılan
// kategori/önek YOKTUR — tenant ilk kurulumda kendi notasyonunu girer.

model DocumentCodingProfile {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyCode    String   @default("")   // örn. tenant'ın kendi belirlediği şirket kısaltması
  separator      String   @default("-")  // kod parçaları arasındaki ayraç
  includeYear    Boolean  @default(true) // koda yıl eklensin mi
  sequenceDigits Int      @default(5)    // sıra no kaç haneli sıfır-dolgulu
  isActive       Boolean  @default(true) // kapalıysa docNumber üretilmez
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DocumentCategoryCode {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String   // tenant'ın kendi tanımladığı kategori kodu (örn. "SOZ")
  label     String   // insan-okunur açıklama (örn. "Sözleşme Evrakları")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
}

model DocumentSequence {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryCode String   // hangi kategori için sayaç
  year         Int      // yıl bazlı sıfırlama için
  lastNumber   Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, categoryCode, year])
}

// ── Genel Hususlar / Kurumsal Yönetim (Faz 3) ────────────────────────────────

model LessonsLearned {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId   String?  // proje seviyesinde veya null → kurumsal seviye
  title       String
  category    String   @default("OTHER") // TECHNICAL | COMMERCIAL | PROCESS | CUSTOMER | SUPPLIER | OTHER
  situation   String   // ne oldu
  rootCause   String?  // kök neden
  action      String?  // alınan/önerilen aksiyon
  impact      String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  status      String   @default("OPEN")   // OPEN | APPLIED | CLOSED
  createdById String?
  createdByName String?
  docNumber   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RiskOpportunity {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        String   @default("RISK") // RISK | OPPORTUNITY
  title       String
  description String?
  category    String   @default("OTHER")
  probability Int      @default(3) // 1..5
  impact      Int      @default(3) // 1..5
  score       Int      @default(9) // probability * impact (uygulamada hesaplanır)
  response    String?  // azaltma/değerlendirme aksiyonu
  owner       String?
  status      String   @default("OPEN") // OPEN | MITIGATING | CLOSED
  docNumber   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CorporateMetric {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String   // KPI adı (örn. "Müşteri Memnuniyeti")
  period      String   // örn. "2026-Q2" veya "2026-06"
  targetValue Float?
  actualValue Float?
  unit        String?  // "%", "adet", "gün", "₺" vb.
  category    String   @default("OTHER")
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name, period])
}

model ExternalDocumentRegister {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String    // dış kaynaklı doküman adı (standart/şartname/yönetmelik)
  source       String?   // kaynak kurum/yayıncı
  externalRef  String?   // dış referans/doküman no
  version      String?
  publishedAt  DateTime?
  reviewedAt   DateTime?
  status       String    @default("ACTIVE") // ACTIVE | SUPERSEDED | WITHDRAWN
  fileUrl      String?
  notes        String?
  docNumber    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ── Faz 6 — Finans Modülü ────────────────────────────────────────────────
model Invoice {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId     String?
  contractId    String?
  purchaseRequestId String? // Satınalma faturasından türeyen finans faturası (idempotency + bağ)
  type          String    @default("SALES") // SALES | PURCHASE
  invoiceNo     String?
  amount        Float     @default(0)
  currency      String    @default("TRY")
  issueDate     DateTime?
  dueDate       DateTime?
  status        String    @default("DRAFT") // DRAFT|ISSUED|SENT|PARTIAL|PAID|OVERDUE|CANCELLED
  paidAmount    Float     @default(0)
  paidAt        DateTime?
  milestoneId   String?
  customerName  String?
  vendorName    String?
  docNumber     String?
  notes         String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  payments      Payment[]
  @@index([tenantId, status])
}

model Payment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Float    @default(0)
  currency    String   @default("TRY")
  paidAt      DateTime @default(now())
  method      String?  // BANK_TRANSFER | CHEQUE | CASH | OTHER
  reference   String?
  notes       String?
  createdAt   DateTime @default(now())
  @@index([tenantId])
}

// ── Faz 6b — Hukuk (Sözleşme Yönetimi modülüne sekme) ────────────────────────
model LegalCase {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type              String    @default("CONTRACT_REVIEW") // CONTRACT_REVIEW|LEGAL_OPINION|DISPUTE|LITIGATION|OTHER
  title             String
  status            String    @default("OPEN") // OPEN|IN_REVIEW|RESPONDED|ESCALATED|CLOSED
  priority          String    @default("MEDIUM") // LOW|MEDIUM|HIGH
  relatedEntityType String?   // contract | project | opportunity | contractWorkflow
  relatedEntityId   String?
  summary           String?
  opinion           String?
  assignedToId      String?
  assignedToName    String?
  requestedById     String?
  requestedByName   String?
  sourceTaskId      String?   // LEGAL TodoTask'tan dönüştürülmüşse
  dueDate           DateTime?
  docNumber         String?
  fileUrl           String?
  closedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  @@index([tenantId, status])
}

model GuaranteeLetter {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId   String?
  contractId  String?
  tenderId    String?   // Faz 3 İhale (BID_BOND) ile paylaşımlı
  type        String    @default("PERFORMANCE") // BID_BOND|PERFORMANCE|ADVANCE|WARRANTY
  bankName    String?
  amount      Float     @default(0)
  currency    String    @default("TRY")
  issueDate   DateTime?
  expiryDate  DateTime?
  status      String    @default("ACTIVE") // ACTIVE|RELEASED|EXPIRED|CALLED
  refNo       String?
  docNumber   String?
  fileUrl     String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([tenantId, status])
}

// Faz 6c — İhale / İSAB (SalesSupport backend modeli)
model Tender {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  ikn                 String?   // İhale Kayıt Numarası (manuel, EKAP yer tutucu)
  authority           String?   // idare adı
  method              String    @default("OPEN") // OPEN|RESTRICTED|NEGOTIATED|DIRECT
  status              String    @default("DRAFT") // DRAFT|PREPARING|SUBMITTED|EVALUATING|WON|LOST|CANCELLED
  submissionDeadline  DateTime?
  estimatedValue      Float     @default(0)
  currency            String    @default("TRY")
  opportunityId       String?
  contractWorkflowId  String?
  ekapRef             String?
  ownerId             String?
  ownerName           String?
  docNumber           String?
  notes               String?
  specText            String?   // idari/teknik şartname + atıf yapılan hususlar metni (analiz girdisi)
  aiAnalysis          String?   // JSON — şartname analizi çıktısı
  remindersSent       String?   // JSON dizi — gönderilen zaman-eşiği hatırlatmaları ['72h','48h','12h','6h']
  submittedAt         DateTime? // "Teklif İletildi" zamanı
  withdrawnAt         DateTime? // yönetim "iştirak etme" kararı zamanı (status=WITHDRAWN)
  withdrawnById       String?   // kararı veren GM
  withdrawReason      String?   // çekilme gerekçesi (yönetimsel)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  checklist           TenderChecklistItem[]
  @@index([tenantId, status])
}

model TenderChecklistItem {
  id          String   @id @default(cuid())
  tenderId    String
  tender      Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  name        String
  isRequired  Boolean  @default(true)
  status      String   @default("PENDING") // PENDING|DONE|WAIVED
  fileUrl     String?
  sortOrder   Int      @default(0)
  notes       String?
  docType       String?  // TAX|BANK|LEGAL|FIRM_CERT|SPEC|ADMIN|OTHER
  deadline      DateTime?
  isAiGenerated Boolean  @default(false)
  source        String?  // MANUAL|AI|CORPORATE_DOC — evrak kaynağı
  corporateDocId String? // Şirket Evrakları envanterinden otomatik eşlenen belge bağı
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([tenderId])
}

// ── Faz 7 — Birim Raporu (yönetici-yazımı + gönderim/inceleme) ───────────────
model UnitReport {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitKey         String    // UNIT_DEFINITIONS key: CRM|PRESALES|PROCUREMENT|FINANCE|LEGAL|TENDER|PROJECT
  unitLabel       String
  periodStart     DateTime
  periodEnd       DateTime
  periodLabel     String?
  status          String    @default("DRAFT") // DRAFT|SUBMITTED|REVIEWED|RETURNED
  authorId        String?
  authorName      String?
  metricsSnapshot String?   // gönderim anında computeUnitMetrics JSON snapshot'ı
  consolidationSnapshot String? // gönderim anı konsolidasyon JSON (personel günlük rapor + ziyaret plan-gerçekleşen)
  escalatedToId   String?   // raporun yönlendiği üst birim yöneticisi (snapshot)
  escalatedToName String?
  highlights      String?   // öne çıkanlar
  issues          String?   // sorunlar
  plannedActions  String?   // planlanan aksiyonlar
  risks           String?   // riskler
  summary         String?   // genel değerlendirme
  submittedAt     DateTime?
  reviewedById    String?
  reviewedByName  String?
  reviewedAt      DateTime?
  reviewNote      String?
  docNumber       String?   // opsiyonel ENF-RPR-...
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([tenantId, unitKey])
  @@index([tenantId, status])
}

// ── Eklenti Lisanslama (Plugin Entitlement) ──────────────────────────────────
// Çekirdek abonelik planından (STARTER/PRO/ENTERPRISE) BAĞIMSIZ add-on katmanı.
// Her satılabilir eklenti (örn. sanal agent) tenant bazında ayrı lisanslanır.
// Katalog kod-seviyesinde (PLUGIN_CATALOG) tanımlı; burada sadece tenant'ın
// hangi eklentiye sahip olduğu + durumu + ayarı tutulur.
model PluginEntitlement {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pluginKey   String    // PLUGIN_CATALOG.key (örn. AGENT_TENDER)
  status      String    @default("DISABLED") // ACTIVE|TRIAL|EXPIRED|DISABLED
  licenseKey  String?   // aktivasyonda kullanılan anahtar
  mode        String    @default("ADVISORY") // agent eklentileri için: ADVISORY|AUTONOMOUS
  config      String?   // eklenti-özel ayar JSON (eşikler, fallback rol vb.)
  activatedById String?
  activatedAt   DateTime?
  expiresAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@unique([tenantId, pluginKey])
  @@index([tenantId, status])
}

// ── Sanal Agent Çalıştırması (Agent Run) ─────────────────────────────────────
// Bir sanal agent bir birimin işini yaptığında üretilen çıktı + ratifikasyon kaydı.
// Danışman modunda: PENDING_RATIFICATION → gerçek kişi RATIFIED/REJECTED yapar.
model AgentRun {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pluginKey     String    // hangi agent eklentisi
  unitKey       String    // hangi birim adına çalıştı
  entityType    String    // TENDER|PROJECT|... işlenen varlık tipi
  entityId      String
  mode          String    @default("ADVISORY") // ADVISORY|AUTONOMOUS
  status        String    @default("PENDING_RATIFICATION") // PENDING_RATIFICATION|RATIFIED|REJECTED
  rationale     String?   // agent gerekçesi (insan-okunur)
  outputJson    String?   // yapısal çıktı (eksik kalemler, risk vb.)
  triggeredById String?   // çalıştıran (manuel) veya null (otomatik)
  handoffTaskId String?   // oluşturulan devir TodoTask id'si
  actionTaken   String?   // otonom modda yürütülen eylemin özeti (null=eylem yok)
  ratifiedById  String?
  ratifiedAt    DateTime?
  ratifyNote    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@index([tenantId, status])
  @@index([tenantId, pluginKey])
}

// Presales → Satışa devredilen BoM kaydı (fırsat-bazlı upsert; KPI + liste/detay)
model BomHandoff {
  id               String   @id @default(cuid())
  tenantId         String
  opportunityId    String
  oppTitle         String
  customerName     String?
  handedOffById    String?
  handedOffByName  String?
  handoffCount     Int      @default(1)
  itemCount        Int      @default(0)
  totalsByCurrency String?  // JSON {TRY:x,USD:y} — mixed-currency güvenliği (tek toplam yok)
  snapshot         String?  // JSON: BoM kalemleri + vendor değerlendirme özeti (devir anının içeriği)
  firstHandoffAt   DateTime @default(now())
  lastHandoffAt    DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@unique([tenantId, opportunityId])
  @@index([tenantId, lastHandoffAt])
}
