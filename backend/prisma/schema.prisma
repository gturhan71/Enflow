// ── Satınalma Modülü ──────────────────────────────────────────────────────

model Vendor {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  taxNo        String?
  address      String?
  phone        String?
  email        String?
  contactName  String?
  iban         String?
  bankName     String?
  categories   String   @default("[]") // JSON string[]
  rating       Float?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  quotes       PurchaseQuote[]
  brands       Brand[]  // taşıdığı/yetkili satıcısı olduğu markalar (2026-08-08, Faz 2) — teklif ekranında marka-uyumlu tedarikçi vurgusu
}

model PurchaseRequest {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  title           String
  description     String?
  sourceType      String   @default("MANUAL")
  // MANUAL | BOM | PROJECT | UNIT
  sourceBomId     String?  // Opportunity.id (BoM kaynaksa)
  projectId       String?
  requestedBy     String   // User.id
  requestedByName String?
  unitId          String?
  unitName        String?
  status          String   @default("DRAFT")
  // DRAFT | PENDING_UNIT | PENDING_PROCUREMENT | PENDING_GM | PO_ISSUED | IN_DELIVERY | INVOICED | CLOSED | REJECTED
  urgency         String   @default("NORMAL")
  // LOW | NORMAL | HIGH | URGENT
  neededBy        DateTime?
  budgetAmount    Float?
  currency        String   @default("TRY")
  budgetAmountTRY Float?
  selectedVendorId   String?
  selectedVendorName String?
  poNumber        String?
  poIssuedAt      DateTime?
  invoiceNo       String?
  invoiceAmount   Float?
  invoiceDate     DateTime?
  invoicePaidAt   DateTime?
  approvedByUnit  String?
  approvedByProcurement String?
  approvedByGM    String?
  rejectedBy      String?
  rejectionNote   String?
  resubmitCount   Int      @default(0) // B-04 — REJECTED→DRAFT (resubmit) kaç kez yapıldı; kayıt/bağlantı (BoM/Proje) korunur
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           PurchaseItem[]
  quotes          PurchaseQuote[]
  deliveries      DeliveryRecord[]

  @@index([tenantId, status])
}

model PurchaseItem {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  quantity          Float
  unit              String  @default("adet")
  estimatedUnitPrice Float?
  currency          String  @default("TRY")
  actualUnitPrice   Float?
  refVendor         String?  // BoM kaynağı: üretici/distribütör adı (referans alış fiyatının kaynağı)
  refSource         String?  // BoM source — referans fiyat kaynağı türü
  lineKey           String?  // BoMItem.lineKey — BoM'dan devredildiyse satır-bazlı maliyet varyansı bağı
  brandId           String?  // BoM handoff'ta BoMItem.brandId'den taşınır (2026-08-08, Faz 2) — teklif ekranında marka-uyumlu tedarikçi vurgusu
  brand             Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  quoteLines        PurchaseQuoteItem[]
}

model PurchaseQuote {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  vendorId          String?
  vendor            Vendor?         @relation(fields: [vendorId], references: [id])
  vendorName        String
  totalAmount       Float
  currency          String  @default("TRY")
  totalAmountTRY    Float?
  deliveryDays      Int?
  validUntil        DateTime?
  notes             String?
  isSelected        Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  items             PurchaseQuoteItem[]
}

// Kalem bazlı tedarikçi teklifi — her PurchaseQuote, talebin her PurchaseItem'ı
// için ayrı miktar+birim fiyat taşır (2026-08-08). totalAmount bu satırların
// toplamından backend'de otorite olarak yeniden hesaplanır (client'a güvenilmez).
model PurchaseQuoteItem {
  id              String        @id @default(cuid())
  purchaseQuoteId String
  purchaseQuote   PurchaseQuote @relation(fields: [purchaseQuoteId], references: [id], onDelete: Cascade)
  purchaseItemId  String
  purchaseItem    PurchaseItem  @relation(fields: [purchaseItemId], references: [id], onDelete: Cascade)
  quantity        Float
  unitPrice       Float
  createdAt       DateTime      @default(now())

  @@unique([purchaseQuoteId, purchaseItemId])
}

// ── Onay Zinciri (Faz 0 — kalıcı ApprovalChain altyapısı) ──────────────────
// workflowService.ts'teki in-memory yapının DB-backed karşılığı.
// Proposal ve ContractWorkflow kendi statü alanlarını korur; bu model
// paralel/ek bir onay geçmişi katmanı olarak eklenir.

model ApprovalChain {
  id         String          @id @default(cuid())
  entityType String          // OPPORTUNITY | PROPOSAL | CONTRACT_WORKFLOW
  entityId   String
  status     String          @default("PENDING") // PENDING | COMPLETED | REJECTED
  processKey String?         // processEngine.ts tarafından üretildiyse hangi processKey'den; null = legacy/DMO gibi motor-dışı zincir
  tenantId   String
  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  stages     ApprovalStage[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([entityType, entityId])
}

model ApprovalStage {
  id         String        @id @default(cuid())
  chainId    String
  chain      ApprovalChain @relation(fields: [chainId], references: [id], onDelete: Cascade)
  role       String?       // FINANCE_MGR | IGPD_MGR | GENERAL_MANAGER | KSU_MGR | ... — null = yalnız unitId (birimdeki herkes)
  unitId     String?       // processEngine.ts tarafından üretilen aşamalarda: WorkflowStep.unitId (rol + birim ikilisi)
  delegateUserId String?   // WorkflowStep.delegateUserId'den kopyalanır (aşama oluşturma anında) — boş koltukta vekil kimin onaylayabileceği
  mode       String        @default("ANY") // ANY|ALL — aynı (chainId, order) değerini paylaşan satırlar için (çoklu onaylayıcı)
  order      Int           @default(0)
  status     String        @default("PENDING") // PENDING | APPROVED | REJECTED | SKIPPED
  approverId String?       // 'AGENT:<pluginKey>' ise sanal agent onayladı
  note       String?
  approvedAt DateTime?
  agentRunId String?       // bu aşamayı onaylayan sanal agent çalıştırması (köken etiketi)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // B-05 — SLA eskalasyonu (approvalSlaEscalation.ts): stage "current" (sıradaki
  // ilk PENDING) olduğunda dueDate atanır; süresi geçip escalatedAt boşsa
  // escalatedToRole (GENERAL_MANAGER) o stage için ek onay yetkisi kazanır —
  // orijinal role sahibinin yetkisi kaldırılmaz, ikisinden ilk onaylayan geçerli olur.
  dueDate         DateTime?
  escalatedAt     DateTime?
  escalatedToRole String?
}

// ── Ziyaret Planı & Günlük Rapor (Faz 2) ────────────────────────────────────
// Diyagramdaki "süreç öncesi" katman: haftalık müşteri ziyaret planı + günlük
// rapor, haftalık olarak bağlı bulunan yöneticiyle (İGPD) paylaşılır.

model VisitPlan {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  weekOf         DateTime // o haftanın Pazartesi tarihi
  preparedById   String
  preparedByName String?
  status         String   @default("DRAFT") // DRAFT | APPROVED | COMPLETED
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  visits         Visit[]
}

model Visit {
  id            String    @id @default(cuid())
  visitPlanId   String
  visitPlan     VisitPlan @relation(fields: [visitPlanId], references: [id], onDelete: Cascade)
  customerId    String?
  customerName  String?
  type          String    @default("OTHER") // DEMO | TECHNICAL_MEETING | PRESENTATION | OTHER
  plannedDate   DateTime
  actualDate    DateTime?
  status        String    @default("PLANNED") // PLANNED | COMPLETED | CANCELLED
  needsCaptured String?   // müşteri ihtiyaçları / görüşme notları
  tenantId      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model DailyReport {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  userId            String
  userName          String?
  date              DateTime
  content           String   // serbest metin günlük rapor
  // İş bağlantısı matrisi (2 eksen): hangi iş üzerine raporlandı
  meetingKind       String   @default("OTHER")       // INTRO(tanışma)|PLANNED|FOLLOWUP|OTHER
  linkType          String   @default("NEW_CONTACT") // NEW_CONTACT|VISIT|OPPORTUNITY|PROJECT
  linkId            String?                          // bağlı varlık id (soft-link); NEW_CONTACT'ta null
  linkLabel         String?                          // anlık etiket (müşteri/fırsat/proje adı veya yeni iletişim)
  isKnownToSystem   Boolean  @default(false)         // linkType != NEW_CONTACT (backend türetir)
  sharedWithManager Boolean  @default(false) // dönem-toplu yöneticiyle paylaşıldı mı
  sharedAt          DateTime?                        // toplu paylaşım anı
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ── Proje Devir Paketi (Faz 2) ───────────────────────────────────────────────
// ContractWorkflowDoc pattern'inin doğrudan klonu — zorunlu evrak checklist'i,
// otomatik durum ilerletme ve multer/Nextcloud upload aynı şekilde çalışır.

model ProjectHandoverDoc {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  docType     String   // FEASIBILITY | TENDER_DOCS | CONTRACT | PRICE_SCHEDULE | COST_TABLE | BOM_TREE | RECEIVED_QUOTES | TENDER_DECISION | GUARANTEE_LETTERS | HANDOVER_FORM | STAFF_LIST | OTHER
  description String?
  status      String   @default("PENDING") // PENDING | IN_PROGRESS | UPLOADED | VERIFIED | WAIVED
  fileUrl     String?
  isRequired  Boolean  @default(true)
  sortOrder   Int      @default(0)
  notes       String?
  docNumber   String?  // tenant doküman kodlama profilinden üretilen özgün kod (opsiyonel)
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DeliveryRecord {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  deliveredAt       DateTime        @default(now())
  receivedBy        String?
  quantityOrdered   Float?
  quantityReceived  Float?
  quantityDamaged   Float?
  status            String  @default("RECEIVED")
  // RECEIVED | PARTIAL | DAMAGED | REJECTED
  notes             String?
  createdAt         DateTime @default(now())
}

// ── Özgün Doküman Kodlama Sistemi (Faz 3) ────────────────────────────────────
// Hiçbir üçüncü-taraf notasyonu gömülmez. Her tenant kendi ISO 9001 doküman
// kontrol standardını Ayarlar → Şirket Profili'nden tanımlar. Varsayılan
// kategori/önek YOKTUR — tenant ilk kurulumda kendi notasyonunu girer.

model DocumentCodingProfile {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyCode    String   @default("")   // örn. tenant'ın kendi belirlediği şirket kısaltması
  separator      String   @default("-")  // kod parçaları arasındaki ayraç
  includeYear    Boolean  @default(true) // koda yıl eklensin mi
  sequenceDigits Int      @default(5)    // sıra no kaç haneli sıfır-dolgulu
  isActive       Boolean  @default(true) // kapalıysa docNumber üretilmez
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DocumentCategoryCode {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String   // tenant'ın kendi tanımladığı kategori kodu (örn. "SOZ")
  label     String   // insan-okunur açıklama (örn. "Sözleşme Evrakları")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
}

model DocumentSequence {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryCode String   // hangi kategori için sayaç
  year         Int      // yıl bazlı sıfırlama için
  lastNumber   Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, categoryCode, year])
}

// ── Genel Hususlar / Kurumsal Yönetim (Faz 3) ────────────────────────────────

model LessonsLearned {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId   String?  // proje seviyesinde veya null → kurumsal seviye
  title       String
  category    String   @default("OTHER") // TECHNICAL | COMMERCIAL | PROCESS | CUSTOMER | SUPPLIER | OTHER
  situation   String   // ne oldu
  rootCause   String?  // kök neden
  action      String?  // alınan/önerilen aksiyon
  impact      String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  status      String   @default("OPEN")   // OPEN | APPLIED | CLOSED
  createdById String?
  createdByName String?
  docNumber   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RiskOpportunity {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        String   @default("RISK") // RISK | OPPORTUNITY
  title       String
  description String?
  category    String   @default("OTHER")
  probability Int      @default(3) // 1..5
  impact      Int      @default(3) // 1..5
  score       Int      @default(9) // probability * impact (uygulamada hesaplanır)
  response    String?  // azaltma/değerlendirme aksiyonu
  owner       String?
  status      String   @default("OPEN") // OPEN | MITIGATING | CLOSED
  docNumber   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CorporateMetric {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String   // KPI adı (örn. "Müşteri Memnuniyeti")
  period      String   // örn. "2026-Q2" veya "2026-06"
  targetValue Float?
  actualValue Float?
  unit        String?  // "%", "adet", "gün", "₺" vb.
  category    String   @default("OTHER")
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name, period])
}

model ExternalDocumentRegister {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String    // dış kaynaklı doküman adı (standart/şartname/yönetmelik)
  source       String?   // kaynak kurum/yayıncı
  externalRef  String?   // dış referans/doküman no
  version      String?
  publishedAt  DateTime?
  reviewedAt   DateTime?
  status       String    @default("ACTIVE") // ACTIVE | SUPERSEDED | WITHDRAWN
  fileUrl      String?
  notes        String?
  docNumber    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ── Faz 6 — Finans Modülü ────────────────────────────────────────────────
model Invoice {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId     String?
  contractId    String?
  purchaseRequestId String? // Satınalma faturasından türeyen finans faturası (idempotency + bağ)
  dmoOrderId    String?   // DMO teslim siparişinden türeyen SALES fatura (idempotency + bağ)
  type          String    @default("SALES") // SALES | PURCHASE
  invoiceNo     String?
  amount        Float     @default(0)
  currency      String    @default("TRY")
  issueDate     DateTime?
  dueDate       DateTime?
  status        String    @default("DRAFT") // DRAFT|ISSUED|SENT|PARTIAL|PAID|OVERDUE|CANCELLED
  paidAmount    Float     @default(0)
  paidAt        DateTime?
  milestoneId   String?
  customerId    String?   // B-xx — Müşteri Sağlık Skoru'nda isim-eşleştirme yerine doğrudan FK (opsiyonel, geriye dönük)
  customer      Customer? @relation(fields: [customerId], references: [id])
  customerName  String?
  vendorName    String?
  docNumber     String?
  notes         String?
  createdById   String?
  issueRateToTRY Float?   // B-18 — kesim anındaki TRY kuru (yabancı para birimli faturada)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  payments      Payment[]
  fxAdjustments FxAdjustment[]
  @@index([tenantId, status])
}

model Payment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Float    @default(0)
  currency    String   @default("TRY")
  paidAt      DateTime @default(now())
  method      String?  // BANK_TRANSFER | CHEQUE | CASH | OTHER
  reference   String?
  notes       String?
  fxAdjustment FxAdjustment?
  createdAt   DateTime @default(now())
  @@index([tenantId])
}

// B-18 — Döviz kur farkı: yabancı para birimli faturada kesim kuru ile tahsilat
// (ödeme) kurunun farkı gerçek TRY kâr/zararı olarak ayrı kalem halinde kaydedilir.
// Kurlar (issueRate/paymentRate) bu kod tabanının genel deseniyle (DMO/CostAnalysis)
// tutarlı biçimde kullanıcı tarafından girilir — canlı kur API'si yok.
model FxAdjustment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentId   String   @unique
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  currency    String   // yabancı para birimi (Invoice.currency)
  amountFx    Float    // ödeme tutarı (yabancı para)
  issueRate   Float    // fatura kesim kuru (1 yabancı = ? TRY)
  paymentRate Float    // tahsilat anındaki kur
  gainLossTRY Float    // (paymentRate − issueRate) × amountFx — pozitif=kazanç, negatif=zarar
  createdAt   DateTime @default(now())
  @@index([tenantId, invoiceId])
}

// ── Faz 6b — Hukuk (Sözleşme Yönetimi modülüne sekme) ────────────────────────
model LegalCase {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type              String    @default("CONTRACT_REVIEW") // CONTRACT_REVIEW|LEGAL_OPINION|DISPUTE|LITIGATION|OTHER
  title             String
  status            String    @default("OPEN") // OPEN|IN_REVIEW|RESPONDED|ESCALATED|CLOSED
  priority          String    @default("MEDIUM") // LOW|MEDIUM|HIGH
  relatedEntityType String?   // contract | project | opportunity | contractWorkflow
  relatedEntityId   String?
  summary           String?
  opinion           String?
  assignedToId      String?
  assignedToName    String?
  requestedById     String?
  requestedByName   String?
  sourceTaskId      String?   // LEGAL TodoTask'tan dönüştürülmüşse
  dueDate           DateTime?
  docNumber         String?
  fileUrl           String?
  closedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  @@index([tenantId, status])
}

model GuaranteeLetter {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId   String?
  contractId  String?
  tenderId    String?   // Faz 3 İhale (BID_BOND) ile paylaşımlı
  type        String    @default("PERFORMANCE") // BID_BOND|PERFORMANCE|ADVANCE|WARRANTY
  bankName    String?
  amount      Float     @default(0)
  currency    String    @default("TRY")
  issueDate   DateTime?
  expiryDate  DateTime?
  isIndefinite Boolean  @default(false) // süresiz teminat (expiryDate yok)
  status      String    @default("ACTIVE") // REQUESTED|ACTIVE|RELEASED|EXPIRED|CALLED
  refNo       String?
  docNumber   String?
  fileUrl     String?
  notes       String?
  requestedById String? // Satış Destek talep eden (status=REQUESTED)
  requestNote   String? // talep notu
  sampleText    String? // idari şartnameden örnek teminat metni
  sampleFileUrl String? // yüklü örnek teminat dosyası
  remindersSent String? // JSON dizi — gönderilen sona-erme hatırlatmaları ['30d','15d','7d'] (B-07)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([tenantId, status])
}

// Faz 6c — İhale / İSAB (SalesSupport backend modeli)
model Tender {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  ikn                 String?   // İhale Kayıt Numarası (manuel, EKAP yer tutucu)
  authority           String?   // idare adı
  method              String    @default("OPEN") // OPEN|RESTRICTED|NEGOTIATED|DIRECT
  status              String    @default("DRAFT") // DRAFT|PREPARING|SUBMITTED|EVALUATING|WON|LOST|CANCELLED|WITHDRAWN (B-10 — bilinçli iştirak etmeme, CANCELLED'dan ayrı, KPI-nötr)
  submissionDeadline  DateTime?
  estimatedValue      Float     @default(0)
  currency            String    @default("TRY")
  opportunityId       String?
  contractWorkflowId  String?
  ekapRef             String?
  ownerId             String?
  ownerName           String?
  docNumber           String?
  notes               String?
  specText            String?   // idari/teknik şartname + atıf yapılan hususlar metni (analiz girdisi)
  aiAnalysis          String?   // JSON — şartname analizi çıktısı
  remindersSent       String?   // JSON dizi — gönderilen zaman-eşiği hatırlatmaları ['72h','48h','12h','6h']
  submittedAt         DateTime? // "Teklif İletildi" zamanı
  withdrawnAt         DateTime? // yönetim "iştirak etme" kararı zamanı (status=WITHDRAWN)
  withdrawnById       String?   // kararı veren GM
  withdrawReason      String?   // çekilme gerekçesi (yönetimsel)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  checklist           TenderChecklistItem[]
  @@index([tenantId, status])
}

model TenderChecklistItem {
  id          String   @id @default(cuid())
  tenderId    String
  tender      Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  name        String
  isRequired  Boolean  @default(true)
  status      String   @default("PENDING") // PENDING|DONE|WAIVED
  fileUrl     String?
  sortOrder   Int      @default(0)
  notes       String?
  docType       String?  // TAX|BANK|LEGAL|FIRM_CERT|SPEC|ADMIN|OTHER
  deadline      DateTime?
  isAiGenerated Boolean  @default(false)
  source        String?  // MANUAL|AI|CORPORATE_DOC — evrak kaynağı
  corporateDocId String? // Şirket Evrakları envanterinden otomatik eşlenen belge bağı
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([tenderId])
}

// ── Faz 7 — Birim Raporu (yönetici-yazımı + gönderim/inceleme) ───────────────
model UnitReport {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitKey         String    // UNIT_DEFINITIONS key: CRM|PRESALES|PROCUREMENT|FINANCE|LEGAL|TENDER|PROJECT
  unitLabel       String
  periodStart     DateTime
  periodEnd       DateTime
  periodLabel     String?
  status          String    @default("DRAFT") // DRAFT|SUBMITTED|REVIEWED|RETURNED
  authorId        String?
  authorName      String?
  metricsSnapshot String?   // gönderim anında computeUnitMetrics JSON snapshot'ı
  consolidationSnapshot String? // gönderim anı konsolidasyon JSON (personel günlük rapor + ziyaret plan-gerçekleşen)
  escalatedToId   String?   // raporun yönlendiği üst birim yöneticisi (snapshot)
  escalatedToName String?
  highlights      String?   // öne çıkanlar
  issues          String?   // sorunlar
  plannedActions  String?   // planlanan aksiyonlar
  risks           String?   // riskler
  summary         String?   // genel değerlendirme
  submittedAt     DateTime?
  reviewedById    String?
  reviewedByName  String?
  reviewedAt      DateTime?
  reviewNote      String?
  docNumber       String?   // opsiyonel ENF-RPR-...
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([tenantId, unitKey])
  @@index([tenantId, status])
}

// ── Eklenti Lisanslama (Plugin Entitlement) ──────────────────────────────────
// Çekirdek abonelik planından (STARTER/PRO/ENTERPRISE) BAĞIMSIZ add-on katmanı.
// Her satılabilir eklenti (örn. sanal agent) tenant bazında ayrı lisanslanır.
// Katalog kod-seviyesinde (PLUGIN_CATALOG) tanımlı; burada sadece tenant'ın
// hangi eklentiye sahip olduğu + durumu + ayarı tutulur.
model PluginEntitlement {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pluginKey   String    // PLUGIN_CATALOG.key (örn. AGENT_TENDER)
  status      String    @default("DISABLED") // ACTIVE|TRIAL|EXPIRED|DISABLED
  licenseKey  String?   // aktivasyonda kullanılan anahtar
  mode        String    @default("ADVISORY") // agent eklentileri için: ADVISORY|AUTONOMOUS
  config      String?   // eklenti-özel ayar JSON (eşikler, fallback rol vb.)
  activatedById String?
  activatedAt   DateTime?
  expiresAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@unique([tenantId, pluginKey])
  @@index([tenantId, status])
}

// ── Sanal Agent Çalıştırması (Agent Run) ─────────────────────────────────────
// Bir sanal agent bir birimin işini yaptığında üretilen çıktı + ratifikasyon kaydı.
// Danışman modunda: PENDING_RATIFICATION → gerçek kişi RATIFIED/REJECTED yapar.
model AgentRun {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pluginKey     String    // hangi agent eklentisi
  unitKey       String    // hangi birim adına çalıştı
  entityType    String    // TENDER|PROJECT|... işlenen varlık tipi
  entityId      String
  mode          String    @default("ADVISORY") // ADVISORY|AUTONOMOUS
  status        String    @default("PENDING_RATIFICATION") // PENDING_RATIFICATION|RATIFIED|REJECTED
  rationale     String?   // agent gerekçesi (insan-okunur)
  outputJson    String?   // yapısal çıktı (eksik kalemler, risk vb.)
  triggeredById String?   // çalıştıran (manuel) veya null (otomatik)
  handoffTaskId String?   // oluşturulan devir TodoTask id'si
  actionTaken   String?   // otonom modda yürütülen eylemin özeti (null=eylem yok)
  ratifiedById  String?
  ratifiedAt    DateTime?
  ratifyNote    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@index([tenantId, status])
  @@index([tenantId, pluginKey])
}

// Presales → Satışa devredilen BoM kaydı (fırsat-bazlı upsert; KPI + liste/detay)
model BomHandoff {
  id               String   @id @default(cuid())
  tenantId         String
  opportunityId    String
  oppTitle         String
  customerName     String?
  handedOffById    String?
  handedOffByName  String?
  handoffCount     Int      @default(1)
  itemCount        Int      @default(0)
  totalsByCurrency String?  // JSON {TRY:x,USD:y} — mixed-currency güvenliği (tek toplam yok)
  snapshot         String?  // JSON: BoM kalemleri + vendor değerlendirme özeti (devir anının içeriği)
  firstHandoffAt   DateTime @default(now())
  lastHandoffAt    DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@unique([tenantId, opportunityId])
  @@index([tenantId, lastHandoffAt])
}

// Taksitli tahsilat planı (finansman etkisi hesabı için)
model CollectionInstallment {
  id            String   @id @default(cuid())
  tenantId      String
  opportunityId String
  dueDate       DateTime
  amount        Float    @default(0)
  currency      String   @default("TRY")
  note          String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([tenantId, opportunityId])
}

// ── Yedekleme / Geri Yükleme (faz_backup) ───────────────────────────────────
// Backup Admin tarafından yönetilir; salt-okunur rol /api/backup'ta mutasyona izinli.
model BackupJob {
  id           String    @id @default(cuid())
  tenantId     String
  scope        String    @default("PLATFORM") // PLATFORM | TENANT
  kind         String    @default("FULL")     // FULL | STATE | DATA
  dbProvider   String    @default("SQLITE")   // SQLITE | POSTGRES
  trigger      String    @default("MANUAL")   // MANUAL | SCHEDULED
  targetType   String    @default("LOCAL")    // LOCAL | NEXTCLOUD | S3
  location     String?                         // hedef dizin/uri
  status       String    @default("PENDING")  // PENDING | RUNNING | COMPLETED | FAILED
  sizeBytes    Int       @default(0)
  checksum     String?                         // sha256 (data artefaktı)
  stateRef     String?                         // state dosyası adı/yolu
  dataRef      String?                         // logical data dosyası adı/yolu
  modelCounts  String?                         // JSON: model -> satır sayısı
  verifyStatus String    @default("PENDING")  // PENDING | PASSED | FAILED
  verifyReport String?                         // JSON
  verifiedAt   DateTime?
  startedById  String?
  startedByName String?
  error        String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  @@index([tenantId, status])
  @@index([tenantId, startedAt])
}

model RestoreJob {
  id                String    @id @default(cuid())
  tenantId          String
  backupId          String
  mode              String    @default("LOGICAL") // LOGICAL | STATE
  status            String    @default("ANALYZING") // ANALYZING | AWAITING_CONFIRM | RESTORING | COMPLETED | FAILED
  diffReport        String?                          // JSON: model -> {added,removed,changed,samples}
  preRestoreBackupId String?                         // güvenlik snapshot
  startedById       String?
  startedByName     String?
  error             String?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  @@index([tenantId, status])
  @@index([tenantId, backupId])
}

// ── DMO Katalog & Kârlılık Modülü ────────────────────────────────────────────
// Devlet Malzeme Ofisi satıcı tarafı: katalog + çerçeve anlaşma + kur + sipariş
// + her sipariş için maliyetlendirme/kârlılık snapshot'ı ve alarm.

model DmoCatalogItem {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dmoCode       String   // DMO stok/malzeme kodu
  name          String
  brandId       String?
  brand         Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  model         String?
  unit          String   @default("ADET")
  listPrice     Float    @default(0)   // DMO katalog satış fiyatı (DMO kuru cinsinden, para birimi currency)
  vatRate       Float    @default(20)
  currency      String   @default("TRY")
  unitCost      Float    @default(0)   // kendi alış maliyeti (costCurrency cinsinden)
  costCurrency  String   @default("TRY")
  categoryId    String?
  category      ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  validFrom     DateTime?
  validTo       DateTime?
  status        String   @default("ACTIVE") // ACTIVE | PASSIVE | EXPIRED
  frameworkAgreementId String?
  frameworkAgreement   DmoFrameworkAgreement? @relation(fields: [frameworkAgreementId], references: [id], onDelete: SetNull)
  docNumber     String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([tenantId, status])
}

model DmoFrameworkAgreement {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agreementNo   String
  title         String
  validFrom     DateTime?
  validTo       DateTime?
  quotaTotal    Float?
  quotaUsed     Float    @default(0)
  status        String   @default("ACTIVE") // ACTIVE | EXPIRED | SUSPENDED | CANCELLED
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  catalogItems  DmoCatalogItem[]
  orders        DmoOrder[]
  @@index([tenantId, status])
}

model DmoExchangeRate {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currency      String   // USD | EUR | ...
  rate          Float    // 1 birim yabancı para = rate TRY (DMO'nun belirlediği)
  validFrom     DateTime @default(now())
  validTo       DateTime? // null = belirsiz / açık uçlu
  source        String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([tenantId, currency])
}

model DmoOrder {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderNo       String
  institutionName String  // alıcı kamu kurumu
  orderDate     DateTime @default(now())
  deliveryDeadline DateTime?
  frameworkAgreementId String?
  frameworkAgreement   DmoFrameworkAgreement? @relation(fields: [frameworkAgreementId], references: [id], onDelete: SetNull)
  currency      String   @default("TRY")
  status        String   @default("EVALUATION")
  // EVALUATION | CONFIRMED | IN_DELIVERY | DELIVERED | INVOICED | CLOSED | REJECTED | CANCELLED
  ownerId       String?
  ownerName     String?
  docNumber     String?
  notes         String?
  // ── Maliyetlendirme / kârlılık snapshot'ı (o anki koşullar) ──
  revenueTotal      Float   @default(0)
  costTotal         Float   @default(0)
  dmoRateSnapshot   Float?  // kullanılan DMO kuru (ana yabancı para kalemi için, bilgi amaçlı)
  rateCurrency      String?
  rateValidFrom     DateTime?
  rateValidTo       DateTime?
  risturnRateApplied Float  @default(0)
  risturnDeduction  Float   @default(0)
  commissionType    String  @default("PERCENT") // PERCENT | FIXED
  commissionValue   Float   @default(0)
  commissionBasis   String  @default("REVENUE") // REVENUE | PROFIT
  commissionDeduction Float @default(0)
  grossProfit       Float   @default(0)
  netProfit         Float   @default(0)
  netMarginPct      Float   @default(0)
  isProfitable      Boolean @default(true)
  alarmReason       String?
  costedAt          DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items         DmoOrderItem[]
  @@index([tenantId, status])
}

model DmoOrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         DmoOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  catalogItemId String?
  name          String
  qty           Float    @default(1)
  unitPrice     Float    @default(0)  // DMO satış fiyatı (sellCurrency)
  sellCurrency  String   @default("TRY") // DMO satış para birimi (kalem bazlı; DMO kuru buna uygulanır)
  unitCost      Float    @default(0)  // kendi alış maliyeti (costCurrency)
  costCurrency  String   @default("TRY")
  vatRate       Float    @default(20)
  lineRevenue   Float    @default(0)
  lineCost      Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([orderId])
}

// ── İşletme Maliyeti (Overhead) + Birim Bütçeleme (Faz 1) ────────────────────
// Çekirdek Finance + Unit uzantısı (ayrı lisans değil; yönetim insiyatifi).

model OperatingCostPool {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodStart   DateTime
  periodEnd     DateTime
  personnelCost Float    @default(0)   // dönem personel gideri
  otherOpex     Float    @default(0)   // kira/enerji/lisans/idari…
  totalPool     Float    @default(0)   // personnelCost + otherOpex (server hesaplar)
  method        String   @default("PCT_OF_VALUE") // PCT_OF_VALUE | PCT_OF_DIRECT_COST | POOL_RATE
  rate          Float    @default(0)   // yüzde (PCT_*) veya oran (POOL_RATE)
  status        String   @default("ACTIVE") // ACTIVE | CLOSED
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([tenantId, status])
}

model UnitBudget {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId          String
  unit            Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  periodStart     DateTime
  periodEnd       DateTime
  personnelBudget Float    @default(0)
  opexBudget      Float    @default(0)
  totalBudget     Float    @default(0)   // personnelBudget + opexBudget (server hesaplar)
  periodCost      Float    @default(0)   // fiili dönem maliyeti (Katman-2 tabanı)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([tenantId, unitId])
}

model ProjectUnitParticipation {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  coefficient Float    @default(0)   // 0..1 — birim dönem maliyetinin bu projeye yüklenen payı (Katman-2)
  role        String?  // birimin projedeki rolü
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([projectId, unitId])
  @@index([projectId])
}

// Çoklu-replika koordinasyonu — in-process zamanlayıcıların (backupScheduler,
// activityLogArchiveScheduler, updateNotifier) yalnız bir replikada çalışmasını
// garanti eden DB-native kilit. Platform-geneli (tenant'tan bağımsız) — süreç
// bazında çalışır. bkz. docs/OLCEKLENDIRME_DUZELTME_PLANI.md Faz A / S-01,
// backend/src/services/schedulerLock.ts
model SchedulerLock {
  name      String   @id
  holder    String
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}
