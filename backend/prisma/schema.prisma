model ArchiveItem {
  id          String   @id @default(cuid())
  boxNo       String
  shelfNo     String
  category    String
  description String?
  owner       String
  date        DateTime @default(now())
  status      String   @default("IN_ARCHIVE")
  tags        String?  // Comma separated or JSON
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}

model ActivityLog {
  id            String      @id @default(cuid())
  action        String      // "UPDATE", "CREATE", "DELETE"
  entityType    String      // "OPPORTUNITY", "CUSTOMER", vb.
  entityId      String
  details       String?     // Değişiklik detayları (JSON string)
  userId        String
  actorType     String?     // HUMAN | AGENT — işlemi yapan aktörün tipi (köken etiketi)
  agentRunId    String?     // AGENT ise ilgili sanal agent çalıştırması
  actorName     String?     // Yazma anında çözülen aktör adı (kullanıcı/agent) — silinen kullanıcıda bile kalır
  entityLabel   String?     // Yazma anında çözülen varlık başlığı/adı (örn. fırsat başlığı) — silinen kayıtta bile kalır
  summary       String?     // Türkçe tek-satır okunabilir özet (Denetim İzi ekranında birincil satır)
  tenantId      String
  timestamp     DateTime    @default(now())
  @@index([tenantId, timestamp])
}

// Denetim izi arşivleme işi — periyodik olarak eski ActivityLog kayıtlarını
// NDJSON dosyasına (sha256 mühürlü) dışa aktarır, hedefe yazar, doğrulanınca
// canlı tablodan siler (bkz. activityLogArchiveService.ts). BackupJob ile
// aynı desen (LOCAL|NEXTCLOUD|S3 hedef, checksum, MANUAL|SCHEDULED tetik).
model ActivityLogArchive {
  id            String    @id @default(cuid())
  tenantId      String
  trigger       String    @default("MANUAL")  // MANUAL | SCHEDULED
  targetType    String    @default("LOCAL")   // LOCAL | NEXTCLOUD | S3
  location      String?                        // dosyanın yazıldığı yol/uri
  format        String    @default("NDJSON")
  fromTimestamp DateTime?                       // arşivlenen en eski kayıt zamanı
  toTimestamp   DateTime?                       // arşivlenen en yeni kayıt zamanı
  recordCount   Int       @default(0)
  sizeBytes     Int       @default(0)
  checksum      String?                        // sha256 — içerik mührü
  status        String    @default("PENDING")  // PENDING | RUNNING | COMPLETED | FAILED
  pruned        Boolean   @default(false)       // arşivlenen kayıtlar canlı tablodan silindi mi
  error         String?
  startedAt     DateTime  @default(now())       // zaman mührü
  completedAt   DateTime?
  @@index([tenantId, status])
  @@index([tenantId, startedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  relatedModule String?  // tıklayınca gidilecek sekme (deep-link)
  relatedItemId String?  // ilgili kayıt (fırsat/proje) — hedef modülde açılır
  isRead    Boolean  @default(false)
  timestamp DateTime @default(now())
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, userId])
}

model CorporateDocument {
  id         String   @id @default(cuid())
  name       String
  category   String
  expiryDate DateTime?
  fileUrl    String?
  tags       String?
  docNumber  String?  // tenant doküman kodlama profilinden üretilen özgün kod (opsiyonel)
  tenantId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
}

model Workflow {
  id          String         @id @default(cuid())
  name        String
  description String?
  isActive    Boolean        @default(true)
  isDefault   Boolean        @default(false) // tenant başına tek varsayılan şablon (legacy, processKey=null kayıtlar için)
  processKey  String?        // süreç motoru anahtarı (OPPORTUNITY_APPROVAL, CONTRACT_SIGNING, ...) — bkz. processEngine.ts
  entityType  String?        // tenant-özel (custom) süreçler için hedef varlık türü (OPPORTUNITY, PROJECT, ...) — generic tetikleme/COPY_FIELDS_TO_TASK bunu kullanır; sabit süreçlerde entityType zaten ilgili route'a hardcoded, burada boş kalabilir
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  steps       WorkflowStep[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([tenantId, processKey])
}

model WorkflowStep {
  id                 String   @id @default(cuid())
  workflowId         String
  workflow           Workflow @relation(fields: [workflowId], references: [id])
  unitId             String
  unit               Unit     @relation(fields: [unitId], references: [id])
  role               String?  // unitId içinde belirli bir role kısıtla; null = birimdeki herkes
  delegateUserId     String?  // VEKİL — birimde aktif kullanıcı yoksa (boş koltuk) düşülecek kişi; resolveStepRecipients bunu unit üyeleri/yöneticisinden sonra dener
  recipientField     String?  // doluysa alıcı Unit/Role yerine işlenen kaydın bu alanından (User ID, ör. 'assignedToId') çözülür — beyaz liste: processEngine.ts ENTITY_RECIPIENT_FIELDS. Bulunamazsa role/unit/delegate zincirine düşer.
  approvalMode       String   @default("ANY") // ANY|ALL — aynı (workflowId, order) değerini paylaşan satırlar için
  actionKey          String?  // type=AUTO adımlarda çalıştırılacak kayıtlı eylem anahtarı (processEngine.ts STAGE_ACTIONS)
  actionConfig       String?  // actionKey'e özel yapılandırma (JSON string) — örn. COPY_FIELDS_TO_TASK için {"fields":["title","value"]}
  order              Int
  // Değişmez kural: bir adım yalnız tenant AÇIKÇA "otomatik devir" (AUTO) olarak
  // işaretlerse insan onayı olmadan ilerler — varsayılan MANUAL'dır (bkz. memory
  // process_engine_immutable_rule.md). AUTO'nun eski varsayılan olması bu kuralı
  // ihlal ediyordu, Faz C'de düzeltildi.
  type               String   @default("MANUAL") // AUTO, MANUAL
  description        String
  nextStepId         String?
  enabled            Boolean  @default(true)  // false = birim akıştan çıkarıldı, görevler sıradaki aktif birime yönlenir
  requiresCompletion Boolean  @default(false) // devretmeden önce birimin gereklilikleri tamamlaması gerekir
  completionNote     String?  // gereklilik açıklaması (uyarıda gösterilir)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

