# Enflow Backend — ortam değişkenleri (örnek). Gerçek .env commit EDİLMEZ.

# Veritabanı
DATABASE_URL=file:./dev.db
# Bağlantı havuzu boyutu — yalnız PostgreSQL (DATABASE_URL postgres:// ile başlarsa).
# Çoklu replikada: replika_sayısı × bu değer ≤ Postgres max_connections olmalı
# (bkz. docs/SYSTEM_REQUIREMENTS.md Senaryo 4). SQLite'ta etkisi yok.
DATABASE_POOL_MAX=10

# ── Güvenlik / Kimlik doğrulama ──────────────────────────────────────────────
# JWT imza anahtarı — ÜRETİMDE ZORUNLU (>=16 karakter, güçlü rastgele değer).
# Ayarlanmazsa dev'de güvensiz sabit anahtara düşer, üretimde süreç açılışta hata verir.
AUTH_JWT_SECRET=
# Oturum token süresi (ms/zaman biçimi): örn 12h, 1d, 30m
AUTH_TOKEN_TTL=12h
# Login brute-force sınırı: IP başına 15 dakikada azami BAŞARISIZ deneme
AUTH_RATE_LIMIT_MAX=50
# Dev/seed varsayılan kullanıcı parolası (yalnız seed + backfill script)
DEFAULT_SEED_PASSWORD=123456
# Tenant verisi şifreleme master key — 32 byte, base64 (örn: openssl rand -base64 32).
# ÜRETİMDE ZORUNLU. Her tenant'ın kendi DEK'ini (Tenant.dekWrapped) sarmalamak için kullanılır
# (envelope encryption — bkz. backend/src/services/tenantEncryption.ts). Ayarlanmazsa dev'de
# güvensiz sabit anahtara düşer, üretimde süreç açılışta hata verir.
DATA_ENCRYPTION_MASTER_KEY=

# CORS izinli origin'ler (virgülle). Boşsa dev localhost setine düşer.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# NODE_ENV=production → hata yanıtlarında stack gizlenir, AUTH_JWT_SECRET zorunlu olur
# NODE_ENV=development

# ── Nextcloud (opsiyonel DMS) ────────────────────────────────────────────────
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_PASS=

# ── Çoklu-replika dağıtım (Senaryo 4 — bkz. docs/SYSTEM_REQUIREMENTS.md) ─────
# Birden fazla backend replikası + load balancer kuruyorsanız true yapın. Bu,
# davranışı DEĞİŞTİRMEZ — yalnız boot'ta paylaşımlı dosya deposu (Nextcloud)
# yapılandırılmamışsa uyarı loglar (backend/src/services/deploymentGuard.ts).
ENFLOW_MULTI_REPLICA=false

# ── YZ (opsiyonel; tenant ayarları yoksa dev fallback) ───────────────────────
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ── Platform Ticket (harici triage aracı) ────────────────────────────────────
# /api/platform-tickets-admin (tüm tenant'ların ürün talepleri, cross-tenant) uçlarını
# korur — normal tenant JWT auth'undan bağımsız, paylaşılan bir secret. Yalnızca dış
# (bu repo dışında) triage aracına verilir; uzun rastgele bir değer olmalı
# (örn. openssl rand -hex 32). Ayarlanmazsa uç 500 döner (fail-closed).
PLATFORM_TICKET_API_KEY=
# Talep oluşturma (POST /api/platform-tickets) — kullanıcı başına saatlik azami talep
PLATFORM_TICKET_RATE_LIMIT_MAX=20
