# Enflow Backend — ortam değişkenleri (örnek). Gerçek .env commit EDİLMEZ.

# Veritabanı
DATABASE_URL=file:./dev.db

# ── Güvenlik / Kimlik doğrulama ──────────────────────────────────────────────
# JWT imza anahtarı — ÜRETİMDE ZORUNLU (>=16 karakter, güçlü rastgele değer).
# Ayarlanmazsa dev'de güvensiz sabit anahtara düşer, üretimde süreç açılışta hata verir.
AUTH_JWT_SECRET=
# Oturum token süresi (ms/zaman biçimi): örn 12h, 1d, 30m
AUTH_TOKEN_TTL=12h
# Login brute-force sınırı: IP başına 15 dakikada azami BAŞARISIZ deneme
AUTH_RATE_LIMIT_MAX=50
# Dev/seed varsayılan kullanıcı parolası (yalnız seed + backfill script)
DEFAULT_SEED_PASSWORD=123456

# CORS izinli origin'ler (virgülle). Boşsa dev localhost setine düşer.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# NODE_ENV=production → hata yanıtlarında stack gizlenir, AUTH_JWT_SECRET zorunlu olur
# NODE_ENV=development

# ── Nextcloud (opsiyonel DMS) ────────────────────────────────────────────────
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_PASS=

# ── YZ (opsiyonel; tenant ayarları yoksa dev fallback) ───────────────────────
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
