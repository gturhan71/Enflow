# Enflow — backend ortam değişkenleri (backend/.env'e kopyalanır)
# Sihirbaz (wizard.mjs) bunu otomatik üretir; elle kurulumda örnek olarak kullanın.

# Backend portu (frontend proxy bunu 3002 bekler — değiştirirseniz vite.config'i de güncelleyin)
PORT=3002

# Veritabanı — SQLite (varsayılan, geliştirme) veya PostgreSQL (üretim)
DATABASE_URL="file:./dev.db"
# Örn. PostgreSQL: DATABASE_URL="postgresql://enflow:sifre@localhost:5432/enflow?schema=public"
#   (PostgreSQL için backend/prisma/schema.prisma datasource provider = "postgresql" olmalı)

# Sırlar — ÜRETİMDE mutlaka güçlü rastgele değerlerle değiştirin (sihirbaz üretir).
JWT_SECRET=degistirin-guclu-rastgele
PLUGIN_LICENSE_SECRET=degistirin-guclu-rastgele

NODE_ENV=production

# (Opsiyonel) Sağlayıcıdan bağımsız YZ — uygulama içi Ayarlar → Entegrasyonlar'dan
# tenant-bazlı da girilebilir. Bunlar sunucu-geneli yedek (fallback) değerlerdir.
# AI_BASE_URL=https://api.saglayici.com/v1
# AI_API_KEY=
# AI_MODEL=

# (Opsiyonel) Nextcloud WebDAV — doküman/yedek depolama
# NEXTCLOUD_URL=
# NEXTCLOUD_USER=
# NEXTCLOUD_PASS=
